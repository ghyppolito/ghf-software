---
// Landing do Pole Position (/poleposition.html e /<código>/poleposition.html), a página inteira com a prop `lang`. Corpo em components/PolePosition.astro, textos
// em i18n/poleposition.ts. Links da página para a home vão à home do mesmo idioma. O acento da
// casca vem de `app` (`data-app`, WP-10 fatia 2). Nav da landing (WP-10, fatia 8, como a do TopoWalk
// na 7): as âncoras das seções que existem e a política do app (`itensNav`); corpo com o padrão do
// Base, sem as classes `brand-*` do legado. O `og:image` segue o de URL fixa em public/assets/.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import PolePosition from '../PolePosition.astro';
import { poleposition } from '../../i18n/poleposition';
import { rota, type Idioma } from '../../i18n/idiomas';
import { itensNav } from '../../i18n/landing';
import JsonLd from '../JsonLd.astro';
import { apps, mobileApplication } from '../../i18n/apps';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = poleposition[lang];
const home = rota(lang, 'index.html');
---
<Base
  title={x.meta.title}
  description={x.meta.description}
  og={{
    imagem: '/assets/poleposition_real_mockup.png',
  }}
  lang={lang}
  caminho="poleposition.html"
  tema="ghf"
  app="poleposition"
  favicon={apps.poleposition.icone}
>
  <JsonLd slot="jsonld" dados={mobileApplication('poleposition', lang, x.meta.description)} />
  <Nav
    lang={lang}
    caminho="poleposition.html"
    inicio={home}
    app="poleposition"
    itens={itensNav(x, lang, 'poleposition')}
  />
  <main id="conteudo" tabindex="-1" class="focus-visible:outline-none">
    <PolePosition lang={lang} />
  </main>
  {/* Canais do app, na ordem da página antiga. */}
  <Footer
    lang={lang}
    inicio={home}
    redes={{
      youtube: 'https://www.youtube.com/channel/UCo7b8Mshb_6atZt-L5Gng1A',
      instagram: 'https://www.instagram.com/pole.position.laptimer/',
      tiktok: 'https://www.tiktok.com/@pole.position.gps',
      facebook: 'https://www.facebook.com/poleposition.laptimer',
    }}
    appAtual="poleposition.html"
  />
</Base>
