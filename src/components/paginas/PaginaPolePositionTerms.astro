---
// Termos de uso do Pole Position (/poleposition-terms.html, URL contratual de ADR-001, e /<código>/poleposition-terms.html): a página
// inteira, com a prop `lang`; as cascas ficam em src/pages/ (ADR-007 §3). Texto em
// src/content/legal/poleposition-terms.<código>.md; hero,
// botão e <head> em i18n/legal.ts. Footer só com o e-mail entre os canais e os termos do Pole Position
// marcados como página atual; o acento da casca vem de `app` (WP-10 fatia 2). O botão volta para a home da
// GHF, como na página antiga.
import { getEntry, render } from 'astro:content';
import LegalLayout from '../../layouts/LegalLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { legal } from '../../i18n/legal';
import { rota, type Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = legal[lang];
const home = rota(lang, 'index.html');
const entrada = await getEntry('legal', `poleposition-terms.${lang}`);
if (!entrada) throw new Error(`src/content/legal/poleposition-terms.${lang}.md ausente`);
const { Content, headings } = await render(entrada);
---
<LegalLayout
  lang={lang}
  caminho="poleposition-terms.html"
  title={x.poleposition_terms_title}
  description={x.poleposition_terms_description}
  titulo={x.poleposition_terms_h1}
  lastUpdated={entrada.data.lastUpdated}
  app="poleposition"
  favicon="/assets/poleposition.png"
  headings={headings}
  voltar={{ href: home, texto: x.voltar_home }}
>
  <Nav
    slot="nav"
    lang={lang}
    caminho="poleposition-terms.html"
    inicio={home}
    itens={[
      { href: `${home}#sobre`, chave: 'nav_about' },
      { href: `${home}#portfolio`, chave: 'nav_portfolio' },
      { href: `${home}#contato`, chave: 'nav_contact' },
    ]}
  />
  <Content />
  <Footer
    slot="footer"
    lang={lang}
    inicio={home}
    redes={{}}
    politicaAtual="poleposition-terms.html"
  />
</LegalLayout>
