---
// Landing do LottoExpert (/lottoexpert.html e /<código>/lottoexpert.html), a página inteira com a prop `lang`. Corpo em components/LottoExpert.astro, textos em
// i18n/lottoexpert.ts. Links da página para a home vão à home do mesmo idioma. O acento da casca vem
// de `app` (`data-app`, WP-10 fatia 2). Nav da landing (WP-10, fatia 9, como a do EclipseGo na 5):
// as âncoras das seções que existem e a política do app (`itensNav`). O `og:image` segue o mockup de
// URL fixa em public/assets/ (contrato byte a byte, D13).
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import LottoExpert from '../LottoExpert.astro';
import { lottoexpert } from '../../i18n/lottoexpert';
import { rota, type Idioma } from '../../i18n/idiomas';
import { itensNav } from '../../i18n/landing';
import JsonLd from '../JsonLd.astro';
import { apps, mobileApplication } from '../../i18n/apps';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = lottoexpert[lang];
const home = rota(lang, 'index.html');
---
<Base
  title={x.meta.title}
  description={x.meta.description}
  og={{
    imagem: '/assets/lottoexpert_app_mockup.png',
  }}
  lang={lang}
  caminho="lottoexpert.html"
  tema="ghf"
  app="lottoexpert"
  favicon={apps.lottoexpert.icone}
>
  <JsonLd slot="jsonld" dados={mobileApplication('lottoexpert', lang, x.meta.description)} />
  <Nav
    lang={lang}
    caminho="lottoexpert.html"
    inicio={home}
    app="lottoexpert"
    itens={itensNav(x, lang, 'lottoexpert')}
  />
  <main id="conteudo" tabindex="-1" class="focus-visible:outline-none">
    <LottoExpert lang={lang} />
  </main>
  <Footer
    lang={lang}
    inicio={home}
    redes={{
      youtube: 'https://www.youtube.com/channel/UC0CgG5V33UB-7zhyfMatUGg',
      instagram: 'https://www.instagram.com/lotto_expert/',
    }}
    appAtual="lottoexpert.html"
  />
</Base>
