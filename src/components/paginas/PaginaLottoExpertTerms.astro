---
// Termos de uso do LottoExpert (/lottoexpert-terms.html, URL contratual de ADR-001, e /<código>/lottoexpert-terms.html): a página
// inteira, com a prop `lang`; as cascas ficam em src/pages/ (ADR-007 §3). Texto em
// src/content/legal/lottoexpert-terms.<código>.md; hero,
// botão e <head> em i18n/legal.ts. Footer só com o e-mail entre os canais e esta página marcada como
// atual; o acento da casca vem de `app` (WP-10 fatia 2). O botão volta para a home da GHF e o selo
// leva o ícone de contrato, como na página antiga.
import { getEntry, render } from 'astro:content';
import LegalLayout from '../../layouts/LegalLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { legal } from '../../i18n/legal';
import { rota, type Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = legal[lang];
const home = rota(lang, 'index.html');
const entrada = await getEntry('legal', `lottoexpert-terms.${lang}`);
if (!entrada) throw new Error(`src/content/legal/lottoexpert-terms.${lang}.md ausente`);
const { Content } = await render(entrada);
---
<LegalLayout
  lang={lang}
  caminho="lottoexpert-terms.html"
  title={x.lottoexpert_terms_title}
  description={x.lottoexpert_terms_description}
  titulo={x.lottoexpert_terms_h1}
  lastUpdated={entrada.data.lastUpdated}
  tema="lottoexpert-terms"
  app="lottoexpert"
  favicon="/assets/lottoexpert_favicon_v3.png"
  classeBody="bg-brand-base text-gray-400 antialiased selection:bg-brand-primary selection:text-white font-sans overflow-x-hidden"
  selo="primary"
  iconeSelo="file-contract"
  voltar={{ href: home, texto: x.voltar_home }}
>
  <Nav
    slot="nav"
    lang={lang}
    caminho="lottoexpert-terms.html"
    inicio={home}
    itens={[
      { href: `${home}#sobre`, chave: 'nav_about' },
      { href: `${home}#portfolio`, chave: 'nav_portfolio' },
      { href: `${home}#contato`, chave: 'nav_contact' },
    ]}
  />
  <Content />
  <Footer
    slot="footer"
    lang={lang}
    inicio={home}
    prefixoAncora={home}
    redes={{}}
    politicaAtual="lottoexpert-terms.html"
  />
</LegalLayout>
