---
// "Todos os apps GHF" da Home (WP-10, fatia 6; D12, `GHF Kit v3` §6): a lista compacta do que não
// entrou na grade (app sem atualização há mais de 12 meses, retirado da Play ou além do 4º). Sem
// desenho no handoff (HOME-VER-TODAS-SEM-DESENHO-01): a lista da 404 (ListaApps.astro, variante
// `home`). App `indisponivel`: nome sem link, selo "Indisponível" e só o link da política. Lista
// vazia: não renderiza.
import ListaApps from './ListaApps.astro';
import { type ChaveApp } from '../i18n/apps';
import { home } from '../i18n/home';
import { type Idioma } from '../i18n/idiomas';

interface Props {
  lang: Idioma;
  chaves: ChaveApp[];
}

const { lang, chaves } = Astro.props;
const x = home[lang];
---
{
  chaves.length > 0 && (
    <div class="mt-[clamp(24px,3vw,40px)] flex flex-col gap-2">
      <h3 class="text-[13px] font-semibold text-text-muted">{x.todos_apps}</h3>
      <ListaApps lang={lang} chaves={chaves} variante="home" />
    </div>
  )
}
