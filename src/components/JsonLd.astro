---
// Dados estruturados (WP-11, ADR-005 §6): um <script type="application/ld+json"> no <head>, pelo
// slot `jsonld` do Base.astro. Os dados vêm de src/i18n/apps.ts. Todo `<` vira a sequência de
// escape `\u003c` (barra invertida, u, 003c), que o JSON lê como o mesmo caractere: nenhum texto
// fecha o <script> antes da hora.
interface Props {
  dados: object;
}

const { dados } = Astro.props;
const json = JSON.stringify(dados).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
