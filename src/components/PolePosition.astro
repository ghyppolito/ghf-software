---
// Corpo da landing do Pole Position (hero, recursos, mockup, público, fluxo, comparativo,
// configurações, stack), comum a /poleposition.html e /en/poleposition.html. Markup transportado
// de poleposition.html (WP-08, fatia 4), textos em src/i18n/poleposition.ts. Nav e footer ficam
// nas páginas.
//
// Cards, passos, linhas da tabela e tecnologias são listas: um markup só por bloco. As classes
// ficam literais aqui (o Tailwind não detecta classe montada por concatenação). Ícones são
// decorativos (o texto ao lado diz o mesmo): aria-hidden.
//
// A página antiga usava `animate-fade-in-up` (e `animation-delay` no atributo style) no texto e
// nos mockups do hero, mas não declarava a classe nem a @keyframes: nada animava. No CSS único a
// classe da home existe; ela sai daqui para reproduzir a página antiga.
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import telaSessao from '../assets/img/poleposition_session_analysis.png';
import telaPainel from '../assets/img/poleposition_live_dashboard.png';
import mockupPole from '../assets/img/poleposition_real_mockup.png';
import { poleposition, tecnologias, type ChavePole } from '../i18n/poleposition';
import { apps } from '../i18n/apps';
import { rota, type Idioma } from '../i18n/ui';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = poleposition[lang];
const txt = (chave: string) => x[chave as ChavePole];

// Ícone grande do fundo e ícone do card de #features, na ordem da página antiga.
const funcionalidades = [
  { n: 1, fundo: { conjunto: 'solid', nome: 'satellite-dish' }, icone: { conjunto: 'solid', nome: 'satellite-dish' } },
  { n: 2, fundo: { conjunto: 'solid', nome: 'gauge-high' }, icone: { conjunto: 'solid', nome: 'gauge-high' } },
  { n: 3, fundo: { conjunto: 'solid', nome: 'bullhorn' }, icone: { conjunto: 'solid', nome: 'bullhorn' } },
  { n: 4, fundo: { conjunto: 'solid', nome: 'road' }, icone: { conjunto: 'solid', nome: 'road' } },
  { n: 5, fundo: { conjunto: 'solid', nome: 'map-location-dot' }, icone: { conjunto: 'solid', nome: 'map-location-dot' } },
  { n: 6, fundo: { conjunto: 'solid', nome: 'file-csv' }, icone: { conjunto: 'solid', nome: 'chart-line' } },
  { n: 7, fundo: { conjunto: 'solid', nome: 'route' }, icone: { conjunto: 'solid', nome: 'route' } },
  { n: 8, fundo: { conjunto: 'solid', nome: 'image' }, icone: { conjunto: 'solid', nome: 'share-nodes' } },
  { n: 9, fundo: { conjunto: 'solid', nome: 'shield-halved' }, icone: { conjunto: 'solid', nome: 'user-shield' } },
] as const;

const publico = [1, 2, 3];
const passos = [1, 2, 3, 4];
const linhas = [1, 2, 3, 4, 5, 6];

const configuracoes = [
  { n: 1, icone: { conjunto: 'solid', nome: 'battery-three-quarters' } },
  { n: 2, icone: { conjunto: 'solid', nome: 'bell-slash' } },
  { n: 3, icone: { conjunto: 'solid', nome: 'mobile-screen-button' } },
] as const;
---
<!-- Hero Section -->
<header class="relative min-h-screen flex items-center pt-32 pb-16 overflow-hidden bg-grid-pattern border-b border-gray-800">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,#0B1120_100%)] z-0"></div>
    <div class="absolute top-1/2 left-1/4 w-96 h-96 bg-brand-primary/20 rounded-full blur-[120px] mix-blend-screen transform -translate-y-1/2 z-0"></div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Text Content -->
            <div class="text-left">
                <div class="inline-flex items-center mb-6 px-4 py-1.5 rounded-full bg-lime-950/40 border border-lime-500/30 text-brand-primary text-sm font-semibold tracking-wide uppercase shadow-[0_0_15px_rgba(132,204,22,0.2)]">
                    <Icon nome="flag-checkered" class="mr-2" /> <span>{x.hero_badge}</span>
                </div>

                <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tight leading-tight">
                    <span>{x.hero_title_1}</span><br>
                    <span class="text-gradient hover:drop-shadow-[0_0_15px_rgba(132,204,22,0.8)] transition-all">{x.hero_title_2}</span>
                </h1>

                <p class="text-xl text-gray-400 mb-10 max-w-2xl leading-relaxed">{x.hero_desc}</p>

                <div class="flex flex-col sm:flex-row items-center gap-4">
                    <a href={apps.poleposition.play} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-brand-primary hover:bg-lime-400 text-black font-bold rounded-lg shadow-glow-accent hover:shadow-lg transition-all duration-300 w-full sm:w-auto text-center flex items-center justify-center gap-3">
                        <Icon conjunto="brands" nome="google-play" class="text-xl" /> <span>{x.btn_download}</span>
                    </a>
                    {/* Política é URL contratual (ADR-001); `rota` dá o par en em /en/. */}
                    <a href={rota(lang, 'poleposition-privacy.html')} class="px-6 py-4 bg-transparent border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white font-semibold rounded-lg transition-all duration-300 w-full sm:w-auto text-center flex items-center justify-center gap-2">
                        <Icon nome="shield-halved" /> <span>{x.btn_privacy}</span>
                    </a>
                </div>
            </div>

            <!-- Product Display (Overlapping Mockups) -->
            <div class="flex justify-center items-center relative h-[550px] md:h-[680px] w-full">
                <div class="absolute inset-0 bg-brand-primary/10 rounded-full blur-3xl z-0"></div>

                <!-- Background Mockup: Session Analysis -->
                <div class="mockup-frame absolute z-10 transform -translate-x-8 translate-y-6 scale-90 opacity-80 border-gray-700/80 shadow-md hover:scale-95 hover:opacity-100 hover:z-30 cursor-pointer">
                    <Image src={telaSessao} alt={x.alt_session} class="w-full h-full object-cover" width={300} densities={[1, 2]} />
                </div>

                <!-- Foreground Mockup: Live Dashboard -->
                <div class="mockup-frame absolute z-20 transform translate-x-8 -translate-y-4 scale-100 shadow-glow-accent border-gray-800 hover:scale-[1.02] hover:z-30 cursor-pointer">
                    <Image src={telaPainel} alt={x.alt_live} class="w-full h-full object-cover" width={300} densities={[1, 2]} />
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Features Section -->
<section id="features" class="py-24 bg-brand-surface relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-brand-primary/20">{x.features_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.features_title}</h2>
            <p class="text-gray-400 text-lg">{x.features_subtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                funcionalidades.map((f) => (
                    <div class="glass-panel p-8 rounded-3xl group hover:-translate-y-2 transition-all duration-300 hover:border-brand-primary/50 relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity">
                            <Icon {...f.fundo} class="text-8xl text-brand-primary" />
                        </div>
                        <div class="w-14 h-14 rounded-2xl bg-brand-primary/10 flex items-center justify-center mb-6 group-hover:bg-brand-primary/20 transition-colors">
                            <Icon {...f.icone} class="text-2xl text-brand-primary" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">{txt(`feat${f.n}_title`)}</h3>
                        <p class="text-sm text-gray-400 leading-relaxed">{txt(`feat${f.n}_desc`)}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- Mockup Real Section -->
<section class="py-16 bg-brand-base relative z-10 border-b border-gray-800 text-center">
    <div class="container mx-auto px-6 md:px-12">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{x.mockup_title}</h2>
        <p class="text-gray-400 mb-10">{x.mockup_desc}</p>
        <Image src={mockupPole} alt={x.alt_mockup} class="max-w-xs mx-auto block rounded-2xl shadow-xl" width={320} densities={[1, 2]} />
    </div>
</section>

<!-- Para quem é Section -->
<section class="py-16 bg-brand-surface relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-10">{x.audience_title}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
            {
                publico.map((n) => (
                    <div class="bg-white/5 rounded-2xl p-6 border border-gray-800">
                        <strong class="block text-brand-primary mb-2">{txt(`audience${n}_title`)}</strong>
                        <p class="text-gray-400">{txt(`audience${n}_desc`)}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- Interactive Workflow Section -->
<section class="py-24 bg-brand-base relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-brand-primary/20">{x.workflow_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.workflow_title}</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            {
                passos.map((n) => (
                    <div class="relative flex flex-col items-center text-center p-6">
                        <div class="w-16 h-16 rounded-full bg-brand-primary/10 border-2 border-brand-primary text-brand-primary flex items-center justify-center text-2xl font-bold mb-6 relative z-10">{n}</div>
                        <h4 class="text-white font-bold text-lg mb-2">{txt(`step${n}_title`)}</h4>
                        <p class="text-sm text-gray-400 leading-relaxed">{txt(`step${n}_desc`)}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- Comparison Section -->
<section class="py-24 bg-brand-surface relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-brand-primary/20">{x.compare_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.compare_title}</h2>
            <p class="text-gray-400 text-lg">{x.compare_subtitle}</p>
        </div>

        <div class="overflow-x-auto max-w-5xl mx-auto glass-panel rounded-3xl shadow-xl">
            <table class="w-full border-collapse text-left">
                <thead>
                    <tr class="border-b border-gray-800 bg-gray-900/50">
                        <th class="py-6 px-6 font-semibold text-white text-sm">{x.th_feature}</th>
                        <th class="py-6 px-6 font-semibold text-gray-300 text-sm">{x.th_hardware}</th>
                        <th class="py-6 px-6 font-semibold text-gray-300 text-sm">{x.th_common_app}</th>
                        <th class="py-6 px-6 font-semibold text-brand-primary text-sm bg-brand-primary/5">{x.th_pole}</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        linhas.map((n) => (
                            <tr class={n < linhas.length ? 'border-b border-gray-800/50 hover:bg-gray-800/10' : 'hover:bg-gray-800/10'}>
                                <td class="py-5 px-6 font-semibold text-white text-sm">{txt(`row${n}_name`)}</td>
                                <td class="py-5 px-6 text-sm text-gray-400">{txt(`row${n}_hardware`)}</td>
                                <td class="py-5 px-6 text-sm text-gray-400">{txt(`row${n}_common`)}</td>
                                <td class="py-5 px-6 text-sm text-brand-primary font-semibold bg-brand-primary/5">{txt(`row${n}_pole`)}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Smart Cockpit Settings Section -->
<section class="py-24 bg-brand-base relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-brand-primary/20">{x.settings_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.settings_title}</h2>
            <p class="text-gray-400 text-lg">{x.settings_desc}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {
                configuracoes.map((c) => (
                    <div class="glass-panel p-8 rounded-3xl hover:border-brand-primary/30 transition-all duration-300">
                        <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center mb-6">
                            <Icon {...c.icone} class="text-2xl text-brand-primary" />
                        </div>
                        <h4 class="text-white font-bold text-xl mb-3">{txt(`set${c.n}_title`)}</h4>
                        <p class="text-sm text-gray-400 leading-relaxed">{txt(`set${c.n}_desc`)}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- Technology Stack -->
<section class="py-24 bg-brand-surface relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-brand-primary/20">{x.tech_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.tech_title}</h2>
            <p class="text-gray-400 text-lg">{x.tech_subtitle}</p>
        </div>

        <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
            {
                tecnologias.map((nome) => (
                    <span class="px-6 py-3 rounded-full border border-gray-800 bg-gray-900/40 text-gray-300 font-semibold text-sm hover:border-brand-primary transition-all duration-300">{nome}</span>
                ))
            }
        </div>
    </div>
</section>
