---
// Moldura de aparelho para captura de tela (WP-30, fatia 1; só CSS, nenhuma imagem de moldura).
// Fica pronta nesta fatia sem consumidor; as landings passam a usá-la na fatia 2.
// - `tamanho`: `m` = 300 px, `g` = 420 px de largura (nunca maior que o contêiner).
// - Borda de 10 px em `--color-raised`, raio 36, anel de 1 px e halo do acento (`shadow-brilho`);
//   a imagem tem raio 26, proporção 9/16, `object-fit: cover` e `object-position` = `posicao`.
// - Halo desfocado atrás (::before, acento a 30%) só a partir de 768 px; `inclinado` gira -3° só a
//   partir de 1024 px. Nada cobre a captura.
// - `loading="lazy"` salvo `eager` (a captura do hero: `fetchpriority="high"`). `alt` descritivo é
//   obrigatório (ADR-006).
// Classes inteiras literais (o Tailwind não detecta concatenação).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagem: ImageMetadata;
  alt: string;
  /** `object-position` da captura (ex.: `top`, `50% 20%`) */
  posicao?: string;
  tamanho?: 'm' | 'g';
  inclinado?: boolean;
  eager?: boolean;
}

const { imagem, alt, posicao = 'top', tamanho = 'm', inclinado = false, eager = false } = Astro.props;
if (!alt.trim()) throw new Error('Aparelho: `alt` vazio — a captura precisa de texto alternativo descritivo');

const largura = tamanho === 'g' ? 420 : 300;
const classeTamanho = tamanho === 'g' ? 'w-[420px]' : 'w-[300px]';
const classeInclinado = inclinado ? 'lg:-rotate-3' : '';
---
<figure
  class={`relative isolate mx-auto max-w-full ${classeTamanho} ${classeInclinado} md:before:absolute md:before:-inset-6 md:before:-z-10 md:before:rounded-[48px] md:before:bg-app-acc/30 md:before:blur-[48px] md:before:content-['']`}
>
  <div class="rounded-[36px] border-[10px] border-raised bg-raised shadow-brilho">
    <Image
      src={imagem}
      alt={alt}
      width={largura}
      densities={[1, 2]}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class="block w-full aspect-[9/16] rounded-[26px] object-cover"
      style={`object-position: ${posicao}`}
    />
  </div>
</figure>
