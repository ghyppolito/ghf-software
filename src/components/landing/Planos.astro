---
// Planos (WP-10, fatia 5; LA:107-160), opcional: "níveis" (cards de preço, nota e tabela de
// comparação; o LottoExpert, fatia 9) ou "grátis e Pro" (dois cards; o TopoWalk, fatia 7). Preço é
// dado do conteúdo. Nota com `selo` opcional (o "18" é do LottoExpert; desvio 9 da especificação).
import Secao from './Secao.astro';
import PlanosNiveis from './PlanosNiveis.astro';
import PlanosGratisPro from './PlanosGratisPro.astro';
import type { Planos } from '../../i18n/landing';
import type { Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
  titulo: string;
  planos: Planos;
  rotuloTermos: string;
  /** `<summary>` das linhas fora da tabela principal (só "níveis") */
  rotuloTabelaCompleta: string;
}

const { lang, titulo, planos, rotuloTermos, rotuloTabelaCompleta } = Astro.props;
---
<Secao id="planos" titulo={titulo} classe="flex flex-col gap-8 lg:gap-10">
  <p slot="lead" class="text-lead text-text-2 text-pretty">{planos.lead}</p>
  {
    planos.tipo === 'niveis' ? (
      <PlanosNiveis lang={lang} titulo={titulo} planos={planos} rotuloTermos={rotuloTermos} rotuloTabelaCompleta={rotuloTabelaCompleta} />
    ) : (
      <PlanosGratisPro lang={lang} planos={planos} rotuloTermos={rotuloTermos} />
    )
  }
</Secao>
