---
// Chamada final (WP-10, fatia 5; WP-30, fatia 2): o fechamento da Home (seção de contato) — glow do
// acento vindo de baixo (`--grad-glow-baixo`, acende com a rolagem: `revela-glow`) e a grade de pontos
// esmaecida, com o `<h2>`, o mesmo botão da Play do hero (mesmo `href`, o único primário) e a mesma
// `meta`, centrados.
import CtaPlay from './CtaPlay.astro';

interface Props {
  titulo: string;
  cta: { href: string; rotulo: string };
  meta?: string;
}

const { titulo, cta, meta } = Astro.props;
---
<section aria-labelledby="h-cta" class="relative isolate overflow-hidden border-t border-border">
  <span aria-hidden="true" class="revela-glow absolute inset-0 -z-10 [background:var(--grad-glow-baixo)]" />
  <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1/2 -z-10 [background:var(--orn-pontos)] [mask-image:linear-gradient(to_top,black,transparent)]" />
  <div class="max-w-[1216px] mx-auto px-[clamp(16px,2.6cqi,32px)] py-[clamp(72px,10cqi,128px)] flex flex-col items-center gap-5 text-center">
    <h2 id="h-cta" class="revela text-section text-balance text-text">{titulo}</h2>
    <CtaPlay href={cta.href} rotulo={cta.rotulo} classe="mt-3 max-w-full" />
    {meta && <span class="text-label text-text-2">{meta}</span>}
  </div>
</section>
