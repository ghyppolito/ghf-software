---
// Seção de landing (WP-10, fatia 5; `Landing App.dc.html`): a largura (1216 px), a margem lateral
// fluida e a divisória de cima do export (D27), um lugar só. Com `titulo`, um `<h2>` que nomeia a
// seção (`aria-labelledby`); sem ele, o `rotulo` vira `aria-label`. `classe` é o layout interno
// (classes literais de quem chama). `compacta` é o respiro menor da faixa de privacidade (LA:162).
// As unidades `cqi` medem o `@container` do Landing.astro.
interface Props {
  id?: string;
  /** id do `<h2>`; padrão `h-{id}` */
  idTitulo?: string;
  titulo?: string;
  rotulo?: string;
  borda?: boolean;
  compacta?: boolean;
  classe?: string;
}

const { id, idTitulo, titulo, rotulo, borda = true, compacta = false, classe } = Astro.props;
const idH = idTitulo ?? (id ? `h-${id}` : undefined);
if (titulo && !idH) throw new Error(`Secao "${titulo}": título sem id (passe \`id\` ou \`idTitulo\`)`);
if (!titulo && !rotulo) throw new Error('Secao sem título nem rótulo');
const temLead = Astro.slots.has('lead');
---
<section
  id={id}
  aria-labelledby={titulo ? idH : undefined}
  aria-label={titulo ? undefined : rotulo}
  class:list={[
    'max-w-[1216px] mx-auto px-[clamp(16px,2.6cqi,32px)]',
    compacta ? 'py-[clamp(28px,4cqi,48px)]' : 'py-[clamp(40px,6cqi,80px)]',
    borda && 'border-t border-border',
    id && 'scroll-mt-4',
    classe,
  ]}
>
  {
    titulo &&
      (temLead ? (
        <div class="flex flex-col gap-2.5 max-w-[680px]">
          <h2 id={idH} class="text-[clamp(26px,3cqi,36px)] leading-[1.2] font-bold tracking-[-0.015em]">{titulo}</h2>
          <slot name="lead" />
        </div>
      ) : (
        <h2 id={idH} class="text-[clamp(26px,3cqi,36px)] leading-[1.2] font-bold tracking-[-0.015em]">{titulo}</h2>
      ))
  }
  <slot />
</section>
