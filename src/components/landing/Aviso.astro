---
// Aviso no fim da landing (WP-10, fatia 5; LA:184-188): faixa `role="note"` de largura inteira. É
// o lugar do aviso de jogo responsável do LottoExpert (fatia 9); o EclipseGo não tem.
interface Props {
  texto: string;
}

const { texto } = Astro.props;
---
<div role="note" class="bg-raised border-t border-border-strong">
  <p class="max-w-[1216px] mx-auto px-[clamp(16px,2.6cqi,32px)] py-5 text-sm leading-[22px] text-pretty">{texto}</p>
</div>
