---
// Hero da landing (WP-10, fatia 5; WP-30, fatia 2 na direção "engenharia luminosa"). Primeira seção,
// com o ornamento `orn-hero` (pontos, anéis e glow do acento, tokens.css). Duas colunas a partir de
// 1024 px (texto 1,1 fr, figura 0,9 fr); abaixo, o texto e depois a figura, centrada. A partir de
// 1024 px o texto alinha ao topo, o respiro vertical é menor e a captura tem 380 px (Aparelho `g`):
// o CTA da Play fica na primeira tela em 1280×720 e 1366×768 (auditoria da fatia 2, 2026-11-24).
// - h1: o título dividido no primeiro ": " — o nome do app em `text`, o descritor numa linha própria
//   no acento (sólido). Sem ": ", sai inteiro. Nunca `.revela` no hero (LCP).
// - `tipo`: `captura` = a tela do app inteira na moldura (`Aparelho`, tamanho `g`, sem inclinar);
//   `foto` = a foto quadrada numa figura com borda e brilho do acento (o EclipseGo).
// A imagem é o LCP: `eager` e `fetchpriority="high"`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CtaPlay from './CtaPlay.astro';
import Aparelho from './Aparelho.astro';

interface Props {
  kicker?: string;
  titulo: string;
  lead: string;
  meta?: string;
  imagem: ImageMetadata;
  tipo?: 'captura' | 'foto';
  alt: string;
  cta: { href: string; rotulo: string };
}

const { kicker, titulo, lead, meta, imagem, tipo = 'captura', alt, cta } = Astro.props;
const corte = titulo.indexOf(': ');
const nome = corte < 0 ? titulo : titulo.slice(0, corte + 1);
const descritor = corte < 0 ? undefined : titulo.slice(corte + 2);
---
<section aria-labelledby="h1" class="orn-hero">
  <div class="max-w-[1216px] mx-auto px-[clamp(16px,2.6cqi,32px)] py-[clamp(40px,8cqi,112px)] lg:py-[clamp(40px,5cqi,72px)] grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center lg:items-start">
    <div class="flex flex-col gap-5 lg:gap-6 min-w-0 lg:pt-6">
      {kicker && <p class="text-eyebrow uppercase text-app-acc">{kicker}</p>}
      <h1 id="h1" class="text-hero text-balance text-text wrap-break-word">
        {nome}{descritor && <> <span class="block text-app-acc">{descritor}</span></>}
      </h1>
      <p class="text-lead text-text-2 max-w-[54ch] text-pretty">{lead}</p>
      <div class="mt-2 flex flex-col gap-3 items-stretch t:items-start">
        <CtaPlay href={cta.href} rotulo={cta.rotulo} classe="w-full t:w-auto" />
        {meta && <span class="text-label text-text-2 mt-1">{meta}</span>}
      </div>
    </div>
    {
      tipo === 'captura' ? (
        <Aparelho imagem={imagem} alt={alt} tamanho="g" eager />
      ) : (
        <figure class="aspect-square w-full max-w-[560px] mx-auto rounded-card-lg border border-app-acc/30 shadow-brilho overflow-hidden">
          <Image
            src={imagem}
            alt={alt}
            widths={[360, 560, 720, 1024]}
            sizes="(min-width:1024px) 560px, min(560px, calc(100vw - 32px))"
            loading="eager"
            fetchpriority="high"
            class="block size-full object-cover"
          />
        </figure>
      )
    }
  </div>
</section>
