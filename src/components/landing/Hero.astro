---
// Hero da landing (WP-10, fatia 5; LA:22-35). Primeira seção, sem divisória. Duas colunas quando
// cabem 2 × 380 px (auto-fit), senão o texto e depois a figura. A figura tem `max-w-[560px]`
// (desvio 1 da especificação: a 768, numa coluna, o quadrado de 560 de altura cortaria a foto).
// A imagem é o LCP: `eager` e `fetchpriority="high"`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CtaPlay from './CtaPlay.astro';

interface Props {
  kicker?: string;
  titulo: string;
  lead: string;
  meta?: string;
  imagem: ImageMetadata;
  alt: string;
  cta: { href: string; rotulo: string };
}

const { kicker, titulo, lead, meta, imagem, alt, cta } = Astro.props;
---
<section class="max-w-[1216px] mx-auto px-[clamp(16px,2.6cqi,32px)] py-[clamp(28px,6cqi,80px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[clamp(28px,5cqi,64px)] items-center">
  <div class="flex flex-col gap-[clamp(14px,1.8cqi,22px)] min-w-0">
    {kicker && <span class="text-sm leading-5 font-semibold text-app-acc">{kicker}</span>}
    <h1 class="text-[clamp(28px,4.4cqi,52px)] leading-[1.12] font-bold tracking-[-0.02em] text-balance wrap-break-word">{titulo}</h1>
    <p class="text-[clamp(16px,1.5cqi,19px)] leading-[1.55] text-text-2 max-w-[54ch] text-pretty">{lead}</p>
    <div class="flex flex-col gap-2.5 items-start mt-1.5">
      <CtaPlay href={cta.href} rotulo={cta.rotulo} />
      {meta && <span class="text-[13px] leading-5 text-text-2">{meta}</span>}
    </div>
  </div>
  <figure class="aspect-square max-h-[560px] w-full max-w-[560px] mx-auto rounded-[20px] border border-border bg-surface overflow-hidden">
    <Image
      src={imagem}
      alt={alt}
      widths={[360, 560, 720, 1024]}
      sizes="(min-width:1024px) 560px, min(560px, calc(100vw - 32px))"
      loading="eager"
      fetchpriority="high"
      class="block size-full object-cover"
    />
  </figure>
</section>
