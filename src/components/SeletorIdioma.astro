---
// Seletor de idioma (WP-15, ADR-007 §7; desenho do WP-10 fatia 2, `Site Nav.dc.html:43-89` e
// `GHF Kit v3.dc.html:338-344`). Lista só as línguas em que a página existe (`linguasDe`, de
// src/i18n/idiomas.json), cada uma um `<a hreflang lang>` comum para a mesma página na outra
// língua: sem redirect, sem JS para navegar, sem bandeira. Todo link leva `data-troca-idioma` com o
// código de destino (inclusive o da língua atual: o clique grava a preferência): o §9 do
// check_site.py isenta esses links, e a faixa de sugestão (SugestaoIdioma) grava a escolha no clique.
// O handoff usa `<button aria-pressed>`; aqui é `<a aria-current="true">`, porque trocar de língua é
// navegar para outra URL e o link funciona sem JS (SELETOR-2-LINGUAS-FORA-DO-HANDOFF-01).
//
// Por número de línguas `n` da página (regra do kit, K3:344; N:137 `two: avail.length <= 3`):
// - n = 1: nada.
// - `barra` (ramos t e d do nav; o Nav esconde abaixo de 600 px):
//   - n ≤ 3: grupo segmentado com o código (PT, EN). O atual tem fundo `raised` e um anel interno
//     `border-strong` (3,30:1): só o fundo dá 1,20:1 sobre `--bg`, abaixo do 3:1 do 1.4.11
//     (resposta 2 do usuário, 2026-11-22).
//   - n ≥ 4: `<details>` com o nome nativo da língua atual e a lista (abre e fecha sem JS; o script
//     só fecha com Esc, clique fora ou foco fora).
// - `menu` (folha do menu no ramo m; o Nav esconde de 600 px para cima), n ≥ 2: rótulo "Idioma" e
//   grade de 2 colunas com o nome nativo e um anel com ponto (o sinal de seleção sem cor).
import { IDIOMAS, caminhoPublico, hreflang, linguasDe, type Idioma } from '../i18n/idiomas';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Idioma;
  /** caminho pt da página atual */
  caminho: string;
  /** onde o seletor está: na barra do nav (t e d) ou na folha do menu (m) */
  posicao: 'barra' | 'menu';
}

const { lang, caminho, posicao } = Astro.props;
const linguas = linguasDe(caminho);
const n = linguas.length;
// Nome acessível que contém o rótulo visível (WCAG 2.5.3): o código aparece no nome quando o nome
// nativo não o tem **como palavra** (`English, EN`, `Português, PT`, `Русский, RU`). Substring não
// basta: o axe compara por palavra, e `ENGLISH` contém `EN` sem ter a palavra `EN`. E sem
// parênteses: o axe (4.14) apaga o que está entre parênteses antes de comparar, e `English (EN)`
// reprovaria igual (WP-22). O `aria-label={g.name}` do handoff (N:46) reprovaria.
function nomeComCodigo(l: Idioma): string {
  const codigo = l.toUpperCase();
  const nome = IDIOMAS[l].nome;
  return nome.toUpperCase().split(/[^\p{L}\p{N}]+/u).includes(codigo) ? nome : `${nome}, ${codigo}`;
}
---
{
  n >= 2 && n <= 3 && posicao === 'barra' && (
    <div role="group" aria-label={t(lang, 'idioma')} class="flex flex-none gap-0.5 p-0.5 border border-border-strong rounded-pill">
      {linguas.map((l) =>
        l === lang ? (
          <a
            href={caminhoPublico(l, caminho)}
            hreflang={hreflang(l)}
            lang={hreflang(l)}
            aria-label={nomeComCodigo(l)}
            aria-current="true"
            data-troca-idioma={l}
            class="flex items-center justify-center min-h-11 min-w-12 px-3 rounded-pill bg-raised ring-1 ring-inset ring-border-strong text-[14px] font-semibold text-text anel-foco"
          >
            {l.toUpperCase()}
          </a>
        ) : (
          <a
            href={caminhoPublico(l, caminho)}
            hreflang={hreflang(l)}
            lang={hreflang(l)}
            aria-label={nomeComCodigo(l)}
            data-troca-idioma={l}
            class="flex items-center justify-center min-h-11 min-w-12 px-3 rounded-pill text-[14px] font-semibold text-text hover:bg-surface anel-foco"
          >
            {l.toUpperCase()}
          </a>
        ),
      )}
    </div>
  )
}
{
  n >= 4 && posicao === 'barra' && (
    <details class="relative flex-none" data-seletor-idioma>
      <summary class="flex items-center gap-2.5 min-h-11 px-3.5 rounded-pill border border-border-strong text-[15px] font-medium text-text hover:bg-raised cursor-pointer list-none [&::-webkit-details-marker]:hidden anel-foco">
        <span lang={hreflang(lang)}>{IDIOMAS[lang].nome}</span>
        <span aria-hidden="true" class="size-[7px] border-r-[1.5px] border-b-[1.5px] border-text-2 -translate-y-0.5 rotate-45" />
      </summary>
      <ul
        aria-label={t(lang, 'idioma')}
        class="absolute right-0 top-[52px] w-[220px] p-1.5 flex flex-col gap-0.5 bg-surface border border-border-strong rounded-card shadow-pop z-10"
      >
        {linguas.map((l) => (
          <li>
            <a
              href={caminhoPublico(l, caminho)}
              hreflang={hreflang(l)}
              lang={hreflang(l)}
              data-troca-idioma={l}
              aria-current={l === lang ? 'true' : undefined}
              class={l === lang
                ? 'flex items-center justify-between gap-3 min-h-11 px-3 rounded-ctl text-[15px] break-words bg-raised text-text anel-foco-interno'
                : 'flex items-center justify-between gap-3 min-h-11 px-3 rounded-ctl text-[15px] break-words text-text hover:bg-raised anel-foco-interno'}
            >
              <span>{IDIOMAS[l].nome}</span>
              {l === lang && <Icon nome="check" class="text-brand" />}
            </a>
          </li>
        ))}
      </ul>
      <script>
        // Fecha a lista com Esc (o foco volta ao gatilho), com clique fora e com o foco fora. Abrir e
        // fechar no gatilho é do próprio <details>, sem script.
        // Foco fora: `relatedTarget` nulo não basta — no Safari o clique num link não o foca, e o
        // focusout do gatilho chega sem destino antes do clique; fechar ali perderia o clique. Com
        // destino nulo, só fecha se o último ponteiro não foi dentro do painel (o clique fora fecha
        // pelo listener de `click`); tecla zera a marca.
        for (const d of document.querySelectorAll<HTMLDetailsElement>('details[data-seletor-idioma]')) {
          const gatilho = d.querySelector('summary');
          let ponteiroDentro = false;
          document.addEventListener('pointerdown', (e) => (ponteiroDentro = d.contains(e.target as Node)), true);
          document.addEventListener('keydown', () => (ponteiroDentro = false), true);
          d.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && d.open) {
              d.open = false;
              gatilho?.focus();
            }
          });
          d.addEventListener('focusout', (e) => {
            const destino = e.relatedTarget as Node | null;
            if (destino ? !d.contains(destino) : !ponteiroDentro) d.open = false;
          });
          document.addEventListener('click', (e) => {
            if (d.open && !d.contains(e.target as Node)) d.open = false;
          });
        }
      </script>
    </details>
  )
}
{
  n >= 2 && posicao === 'menu' && (
    <>
      <div class="h-px bg-border mx-3 my-2" />
      <p class="px-3 pt-1.5 pb-1 text-[13px] font-semibold text-text-muted">{t(lang, 'idioma')}</p>
      <ul aria-label={t(lang, 'idioma')} class="grid grid-cols-2 gap-1">
        {linguas.map((l) => (
          <li>
            <a
              href={caminhoPublico(l, caminho)}
              hreflang={hreflang(l)}
              lang={hreflang(l)}
              data-troca-idioma={l}
              aria-current={l === lang ? 'true' : undefined}
              class={l === lang
                ? 'flex items-center gap-2.5 min-h-11 px-3 rounded-ctl text-[15px] break-words bg-raised text-text anel-foco-interno'
                : 'flex items-center gap-2.5 min-h-11 px-3 rounded-ctl text-[15px] break-words text-text anel-foco-interno'}
            >
              <span
                aria-hidden="true"
                class={l === lang
                  ? 'flex flex-none items-center justify-center size-4 rounded-full border-[1.5px] border-brand'
                  : 'flex flex-none items-center justify-center size-4 rounded-full border-[1.5px] border-border-strong'}
              >
                {l === lang && <span class="size-2 rounded-full bg-brand" />}
              </span>
              <span>{IDIOMAS[l].nome}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
