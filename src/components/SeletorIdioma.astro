---
// Seletor de idioma (WP-15, ADR-007 §7; desenho: especificação do site-ux no WP-15, handoff
// `Site Nav.dc.html`). Lista só as línguas em que a página existe (`linguasDe`, de
// src/i18n/idiomas.json), cada uma um `<a hreflang lang>` comum para a mesma página na outra
// língua: sem redirect, sem JS para navegar, sem bandeira. Todo link leva `data-troca-idioma` com o
// código de destino: o §9 do check_site.py isenta esses links, e a faixa de sugestão
// (SugestaoIdioma) grava a escolha no clique.
//
// Por número de línguas `n` da página:
// - n = 1: nada.
// - n = 2: um link para a outra língua, com o globo e o código (o markup do antigo TrocaIdioma,
//   byte a byte), na barra do desktop e na do celular; nada no menu do celular.
// - n ≥ 3: na barra do desktop, `<details>` com o nome nativo da língua atual e a lista (abre e
//   fecha sem JS; o script só fecha com Esc, clique fora ou foco fora); na barra do celular, nada;
//   no menu do celular, uma grade com os nomes nativos.
import { IDIOMAS, caminhoPublico, hreflang, linguasDe, type Idioma } from '../i18n/idiomas';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Idioma;
  /** caminho pt da página atual */
  caminho: string;
  /** onde o seletor está: barra do desktop, barra do celular ou menu do celular (sobreposto) */
  posicao: 'barra' | 'celular' | 'menu';
  /** classes do link com 2 línguas (as de cada `realce` do Nav) */
  class?: string;
}

const { lang, caminho, posicao, class: classe = '' } = Astro.props;
const linguas = linguasDe(caminho);
const n = linguas.length;
const outro = linguas.find((l) => l !== lang) as Idioma;
// Nome acessível que contém o rótulo visível (WCAG 2.5.3): o código aparece no nome quando o nome
// nativo não o contém (`Português (PT)`, `Русский (RU)`; `English`, `Español` já contêm).
const codigo = outro?.toUpperCase();
const nomeOutro = outro && (IDIOMAS[outro].nome.toUpperCase().includes(codigo) ? IDIOMAS[outro].nome : `${IDIOMAS[outro].nome} (${codigo})`);
const foco = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---
{
  n === 2 && posicao !== 'menu' && (
    <a
      href={caminhoPublico(outro, caminho)}
      hreflang={hreflang(outro)}
      lang={hreflang(outro)}
      aria-label={nomeOutro}
      data-troca-idioma={outro}
      class={classe}
    >
      <Icon nome="globe" />
      <span>{codigo}</span>
    </a>
  )
}
{
  n >= 3 && posicao === 'barra' && (
    <details class="relative border-l border-gray-700 pl-6 ml-2" data-seletor-idioma>
      <summary class={`flex items-center gap-2 min-h-11 px-4 rounded-full border border-gray-500 text-gray-300 hover:text-white font-semibold cursor-pointer list-none [&::-webkit-details-marker]:hidden ${foco}`}>
        <Icon nome="globe" />
        <span lang={hreflang(lang)}>{IDIOMAS[lang].nome}</span>
        <Icon nome="chevron-down" class="text-xs" />
      </summary>
      <ul
        aria-label={t(lang, 'idioma')}
        class="absolute right-0 top-full mt-2 w-[220px] bg-brand-surface border border-gray-600 rounded-xl shadow-xl p-1.5 flex flex-col gap-0.5 z-10"
      >
        {linguas.map((l) => (
          <li>
            <a
              href={caminhoPublico(l, caminho)}
              hreflang={hreflang(l)}
              lang={hreflang(l)}
              data-troca-idioma={l}
              aria-current={l === lang ? 'true' : undefined}
              class={`flex items-center justify-between gap-2 min-h-11 px-3 rounded-lg text-[15px] break-words ${l === lang ? 'bg-white/5 text-white' : 'text-gray-300 hover:text-white hover:bg-white/5'} ${foco}`}
            >
              <span>{IDIOMAS[l].nome}</span>
              {l === lang && <Icon nome="check" class="text-brand-primary" />}
            </a>
          </li>
        ))}
      </ul>
      <script>
        // Fecha a lista com Esc (o foco volta ao gatilho), com clique fora e com o foco fora. Abrir e
        // fechar no gatilho é do próprio <details>, sem script.
        // Foco fora: `relatedTarget` nulo não basta — no Safari o clique num link não o foca, e o
        // focusout do gatilho chega sem destino antes do clique; fechar ali perderia o clique. Com
        // destino nulo, só fecha se o último ponteiro não foi dentro do painel (o clique fora fecha
        // pelo listener de `click`); tecla zera a marca.
        for (const d of document.querySelectorAll<HTMLDetailsElement>('details[data-seletor-idioma]')) {
          const gatilho = d.querySelector('summary');
          let ponteiroDentro = false;
          document.addEventListener('pointerdown', (e) => (ponteiroDentro = d.contains(e.target as Node)), true);
          document.addEventListener('keydown', () => (ponteiroDentro = false), true);
          d.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && d.open) {
              d.open = false;
              gatilho?.focus();
            }
          });
          d.addEventListener('focusout', (e) => {
            const destino = e.relatedTarget as Node | null;
            if (destino ? !d.contains(destino) : !ponteiroDentro) d.open = false;
          });
          document.addEventListener('click', (e) => {
            if (d.open && !d.contains(e.target as Node)) d.open = false;
          });
        }
      </script>
    </details>
  )
}
{
  n >= 3 && posicao === 'menu' && (
    <div class="w-full max-w-xs px-6 flex flex-col gap-3">
      <div class="h-px bg-gray-700" />
      <p class="text-[13px] font-semibold text-gray-400">{t(lang, 'idioma')}</p>
      <ul aria-label={t(lang, 'idioma')} class="grid grid-cols-2 gap-1">
        {linguas.map((l) => (
          <li>
            <a
              href={caminhoPublico(l, caminho)}
              hreflang={hreflang(l)}
              lang={hreflang(l)}
              data-troca-idioma={l}
              aria-current={l === lang ? 'true' : undefined}
              class={`flex items-center gap-2 min-h-11 px-3 rounded-lg text-[15px] break-words ${l === lang ? 'bg-white/5 text-white' : 'text-gray-300 hover:text-white hover:bg-white/5'} ${foco}`}
            >
              <span
                aria-hidden="true"
                class={l === lang ? 'shrink-0 w-2.5 h-2.5 rounded-full border-2 border-brand-primary bg-brand-primary' : 'shrink-0 w-2.5 h-2.5 rounded-full border-2 border-brand-primary'}
              />
              <span>{IDIOMAS[l].nome}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
