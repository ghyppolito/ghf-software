---
// Corpo da landing do EclipseGo (hero, recursos, como funciona, stack), comum a /eclipsego.html e
// /en/eclipsego.html. Markup transportado de eclipsego.html (WP-08, fatia 5), textos em
// src/i18n/eclipsego.ts. Nav e footer ficam nas páginas.
//
// Cards, passos e tecnologias são listas: um markup só por bloco. As classes ficam literais aqui
// (o Tailwind não detecta classe montada por concatenação). Ícones são decorativos (o texto ao
// lado diz o mesmo): aria-hidden.
//
// O blob do hero chamava `animation: float 8s` no atributo style, mas a página antiga não declarava
// a @keyframes: ficava parado no centro. No CSS único a @keyframes da home existe e o transform
// dela tiraria o blob do centro; o atributo sai, reproduzindo a página antiga. `corona-glow` (o
// brilho pulsante da moldura do celular) era declarada na página e continua, em global.css.
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import telaEclipse from '../assets/img/eclipsego_phone_screen.png';
import { eclipsego, tecnologias } from '../i18n/eclipsego';
import { textoDaChave } from '../i18n/ui';
import { apps } from '../i18n/apps';
import { link, type Idioma } from '../i18n/idiomas';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = eclipsego[lang];
const txt = (chave: string) => textoDaChave(x, chave, `eclipsego.ts [${lang}]`);

// Ícone de cada card de recursos, na ordem da página antiga. O card 1 ("offline") fica sem ícone,
// como estava no ar: a página antiga pedia `fa-wifi-slash`, que não existe no FA Free 6.4.0 (D21,
// opção C: o ícone é escolhido no WP-10).
const funcionalidades: { n: number; icone: { conjunto: 'solid'; nome: string } | null }[] = [
  { n: 1, icone: null },
  { n: 2, icone: { conjunto: 'solid', nome: 'location-dot' } },
  { n: 3, icone: { conjunto: 'solid', nome: 'timeline' } },
  { n: 4, icone: { conjunto: 'solid', nome: 'calendar-days' } },
];

const passos = [1, 2, 3, 4];
---
<!-- Hero Section -->
<header class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden bg-grid-pattern">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,#0B1120_100%)] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-base/80 to-brand-base z-0"></div>

    <!-- Abstract gradient blob -->
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-primary rounded-full mix-blend-screen filter blur-[150px] opacity-10"></div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Text Content -->
            <div class="w-full lg:w-1/2 text-center lg:text-left">
                <div class="inline-block mb-4 px-4 py-1.5 rounded-full border border-yellow-500/30 bg-yellow-900/20 backdrop-blur-sm text-sm text-yellow-400 font-medium">
                    <Icon nome="moon" class="mr-2 animate-pulse" /> <span>{x.hero_badge}</span>
                </div>

                <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight mb-6 text-white">
                    <span>{x.hero_title_1}</span><br class="hidden md:block"> <span class="text-gradient">{x.hero_title_2}</span>
                </h1>

                <p class="mt-4 text-xl text-gray-400 max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-10">{x.hero_desc}</p>

                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <a href={apps.eclipsego.play} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-brand-primary hover:bg-brand-primaryHover text-black font-bold rounded-lg shadow-glow hover:shadow-lg transition-all duration-300 w-full sm:w-auto text-center flex items-center justify-center gap-3">
                        <Icon conjunto="brands" nome="google-play" class="text-xl" /> <span>{x.btn_play}</span>
                    </a>
                    {/* Política é URL contratual (ADR-001); `link` dá o par na língua da página (D23). */}
                    <a {...link(lang, 'eclipsego-privacy.html')} class="px-8 py-4 bg-transparent border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white font-semibold rounded-lg transition-all duration-300 w-full sm:w-auto text-center flex items-center justify-center gap-2">
                        <Icon nome="shield-halved" /> <span>{x.btn_privacy}</span>
                    </a>
                </div>
            </div>

            <!-- Visual Content -->
            <div class="w-full lg:w-1/2 flex justify-center">
                <div class="relative w-72 h-[600px] border-[8px] border-gray-900 rounded-[3rem] shadow-2xl overflow-hidden glass-panel flex flex-col items-center justify-center bg-brand-base corona-glow">
                    <!-- Camera Notch -->
                    <div class="absolute top-0 w-1/2 h-6 bg-gray-900 mx-auto rounded-b-3xl z-20"></div>

                    <!-- Real App Screenshot -->
                    <Image src={telaEclipse} alt={x.alt_screen} class="absolute inset-0 w-full h-full object-cover z-10" width={288} densities={[1, 2]} />

                    <!-- Status Mention overlay -->
                    <div class="absolute bottom-10 px-4 py-1.5 rounded-full border border-yellow-500/30 bg-yellow-950/80 text-xs font-semibold text-yellow-400 flex items-center gap-2 z-20 shadow-lg backdrop-blur-sm">
                        <span class="w-2 h-2 rounded-full bg-yellow-400 animate-ping" aria-hidden="true"></span>
                        <span>{x.badge_available}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Features Grid -->
<section class="py-24 bg-brand-surface relative z-10 border-t border-gray-800/50">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-yellow-500/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-yellow-500/20">{x.features_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.features_title}</h2>
            <p class="text-gray-400 text-lg">{x.features_subtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                funcionalidades.map((f) => (
                    <div class="glass-panel p-8 rounded-2xl hover:-translate-y-2 transition-transform duration-300 group">
                        <div class="w-14 h-14 rounded-xl bg-yellow-900/30 border border-yellow-500/20 flex items-center justify-center text-brand-primary text-2xl mb-6 group-hover:scale-110 transition-transform">
                            {f.icone && <Icon {...f.icone} />}
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">{txt(`feat${f.n}_title`)}</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">{txt(`feat${f.n}_desc`)}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- How it Works -->
<section id="how" class="py-24 bg-brand-base relative z-10">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-gray-800 text-gray-300 text-sm font-semibold tracking-wide uppercase border border-gray-700">{x.workflow_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold text-white">{x.workflow_title}</h2>
        </div>

        <div class="max-w-4xl mx-auto">
            <div class="relative border-l border-yellow-500/50 ml-6 md:ml-10 space-y-12">
                {
                    passos.map((n) => (
                        <div class="relative pl-10 md:pl-16">
                            <div class="absolute -left-5 md:-left-6 top-0 w-10 h-10 md:w-12 md:h-12 rounded-full bg-brand-base border-2 border-yellow-500 flex items-center justify-center text-brand-primary font-bold text-lg">{n}</div>
                            <h3 class="text-2xl font-bold text-white mb-3">{txt(`step${n}_title`)}</h3>
                            <p class="text-gray-400 text-lg leading-relaxed">{txt(`step${n}_desc`)}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<!-- Technology Stack -->
<section class="py-24 bg-brand-surface relative z-10 border-b border-gray-800">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <div class="inline-block mb-3 px-3 py-1 rounded-full bg-yellow-500/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-yellow-500/20">{x.tech_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">{x.tech_title}</h2>
            <p class="text-gray-400 text-lg">{x.tech_subtitle}</p>
        </div>

        <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
            {
                tecnologias.map((nome) => (
                    <span class="px-6 py-3 rounded-full border border-gray-800 bg-gray-900/40 text-gray-300 font-semibold text-sm hover:border-brand-primary transition-all duration-300">{nome}</span>
                ))
            }
        </div>
    </div>
</section>
