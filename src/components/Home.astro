---
// Corpo da home (/ e /en/): hero, grade dos apps, Sobre e Privacidade (WP-10, fatia 6;
// `Home.dc.html` da rodada 3, D30). Textos em src/i18n/home.ts (o EclipseGo e o LottoExpert no `<app>.ts`), dados
// dos apps em src/i18n/apps.ts. Nav e footer ficam em paginas/PaginaHome.astro.
// - Cards na ordem de `ORDEM_APPS` (brief §10, mesmo peso); entra na grade o que `particionarApps`
//   (D12) põe em `destaque`, o resto vai para "Todos os apps GHF" (VerTodasApps).
// - O card inteiro é o alvo da landing (link esticado no nome, `after:inset-0`); o Play fica por
//   cima (`relative z-10`). Sem botão primário, sem animação, sem transição.
// - Ponto de troca mobile/desktop do export: 700 px, escrito em rem (`min-[43.75rem]:`), como o
//   `t:` de tokens.css, para a ordem das variantes no CSS não inverter. Grade 1 / 2 / 4 colunas
//   (700 / 1280): o `auto-fit` do export deixava um card sozinho entre ~810 e ~1065 px.
// - `clamp` e tamanhos em px literais do export, sem token do Kit (LITERAIS-SEM-TOKEN-HOME-01); a
//   cor é sempre token.
// - `id="portfolio"` (não `apps`, como no export): Nav, 404 e landings apontam `/#portfolio`.
// - Sobre e Privacidade são duas regiões (`<section>` com `aria-labelledby`) num `<div id="sobre">`
//   que só faz a grade (fatia 10a, SOBRE-REGIAO-ENGLOBA-PRIVACIDADE-01): o `#sobre` fica no
//   invólucro com o padding, para o salto da nav pousar onde pousava.
import { Image } from 'astro:assets';
import { home } from '../i18n/home';
import { eclipsego } from '../i18n/eclipsego';
import { lottoexpert } from '../i18n/lottoexpert';
import { apps, ORDEM_APPS, COR_APP, particionarApps, hojeDoBuild, dataCurta, type ChaveApp } from '../i18n/apps';
import { t } from '../i18n/ui';
import { link, type Idioma } from '../i18n/idiomas';
import { iconesApps } from '../assets/icones-apps';
import VerTodasApps from './VerTodasApps.astro';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = home[lang];

// Resumo de cada card: o EclipseGo e o LottoExpert já estão no formato de landing (eclipsego.ts,
// lottoexpert.ts); os outros dois leem home.ts até a landing deles migrar (fatias 7 e 8: troca só a
// linha do app).
const resumos: Record<ChaveApp, { tag: string; curta: string }> = {
  lottoexpert: lottoexpert[lang].resumo,
  topowalk: x.resumos.topowalk,
  poleposition: x.resumos.poleposition,
  eclipsego: eclipsego[lang].resumo,
};

const { destaque, resto } = particionarApps(hojeDoBuild());
const privacidade = t(lang, 'footer_privacy');
---
<section aria-labelledby="h1" class="max-w-[1216px] mx-auto px-[clamp(16px,2.6vw,32px)] pt-[clamp(20px,6vw,80px)] pb-[clamp(16px,3vw,40px)] flex flex-col gap-[clamp(8px,1.4vw,16px)]">
  <p class="hidden min-[43.75rem]:block text-[14px] font-semibold text-brand">GHF Software · {x.since_2004}</p>
  <h1 id="h1" class="text-[length:clamp(26px,4.6vw,56px)] leading-[1.12] font-bold tracking-[-0.025em] max-w-[16ch] text-balance text-text">{x.hero_title}</h1>
  <p class="hidden min-[43.75rem]:block text-lg text-text-2 max-w-[52ch] text-pretty">{x.hero_desc}</p>
</section>

<section id="portfolio" aria-labelledby="h-apps" class="max-w-[1216px] mx-auto px-[clamp(16px,2.6vw,32px)]">
  <h2 id="h-apps" class="sr-only">{x.apps_titulo}</h2>
  {
    destaque.length > 0 && (
      <div class="grid grid-cols-1 min-[43.75rem]:grid-cols-2 xl:grid-cols-4 gap-[clamp(8px,1.4vw,16px)]">
        {destaque.map((c) => {
          const a = apps[c];
          const r = resumos[c];
          return (
            <article class="relative flex flex-col gap-2.5 overflow-hidden rounded-card border border-border bg-surface p-4 hover:border-border-strong hover:bg-raised">
              <span aria-hidden="true" class={`absolute inset-x-0 top-0 h-[3px] ${COR_APP[c].fundo}`} />
              <div class="flex items-center gap-3">
                <Image src={iconesApps[c]} alt="" width={44} height={44} densities={[1, 2]} loading="eager" class="size-11 flex-none rounded-[10px] object-cover bg-raised" />
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg/6 font-bold">
                    <a {...link(lang, a.pagina)} class="text-text no-underline after:absolute after:inset-0 after:content-[''] anel-foco rounded-[4px] [overflow-wrap:anywhere]">{a.nome}</a>
                  </h3>
                  <span class="text-[12px] leading-4 text-text-2 flex items-center gap-1.5">
                    <span aria-hidden="true" class="font-extrabold text-success">✓</span>
                    {x.selo_publicado}
                  </span>
                </div>
                <a href={a.play} target="_blank" rel="noopener noreferrer" aria-label={x.play_rotulo.replace('{app}', a.nome)} class="relative z-10 min-h-11 px-3.5 inline-flex items-center gap-1 flex-none rounded-pill border border-border-strong text-[13px] font-semibold text-text no-underline hover:border-text anel-foco">
                  {x.play_curto}<span aria-hidden="true">↗</span>
                </a>
              </div>
              <p class="text-[14px] leading-[21px] text-text-2 text-pretty">{r.curta}</p>
              <div class="mt-auto pt-1.5 border-t border-border flex items-center justify-between gap-2">
                <div class="flex flex-col">
                  <span class="hidden min-[43.75rem]:block text-[13px] text-text-muted">{r.tag}</span>
                  <span class="text-[12px] leading-4 text-text-muted">
                    {x.atualizado}: <time datetime={a.atualizadoEm}>{dataCurta(a.atualizadoEm, lang)}</time>
                  </span>
                </div>
                <span aria-hidden="true" class={`hidden min-[43.75rem]:inline text-[14px] font-semibold ${COR_APP[c].texto}`}>→</span>
              </div>
            </article>
          );
        })}
      </div>
    )
  }
  <VerTodasApps lang={lang} chaves={resto} />
</section>

<div id="sobre" class="max-w-[1216px] mx-auto px-[clamp(16px,2.6vw,32px)] py-[clamp(48px,7vw,96px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-[clamp(28px,4vw,48px)]">
  <section aria-labelledby="h-sobre" class="flex flex-col gap-3">
    <h2 id="h-sobre" class="text-[length:clamp(22px,2.4vw,28px)] leading-[1.25] font-bold text-text">{x.sobre_titulo}</h2>
    <p class="text-body text-text-2 text-pretty" set:html={x.about_p1Html} />
  </section>
  <section aria-labelledby="h-privacidade" class="flex flex-col gap-3">
    <h2 id="h-privacidade" class="text-[length:clamp(22px,2.4vw,28px)] leading-[1.25] font-bold text-text">{privacidade}</h2>
    <ul class="flex flex-wrap gap-x-5">
      {
        ORDEM_APPS.map((c) => (
          <li>
            <a {...link(lang, apps[c].privacidade)} class="min-h-11 flex items-center text-[15px] text-text underline decoration-brand underline-offset-4 hover:decoration-2 anel-foco">
              {apps[c].nome}<span class="sr-only"> — {privacidade}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>
