---
// Corpo da home (hero, Sobre, Portfólio), comum a / e /en/. Markup transportado de index.html
// (WP-08, fatia 1), textos em src/i18n/home.ts. Nav e footer ficam nas páginas.
import { home } from '../i18n/home';
import { apps } from '../i18n/apps';
import { rota, type Idioma } from '../i18n/ui';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import iconeTopo from '../assets/img/topo-walk.png';
import iconeEclipse from '../assets/img/eclipse-go-favicon.png';
import logoEclipse from '../assets/img/eclipse-go.png';
import iconePole from '../assets/img/poleposition.png';
import iconeLotto from '../assets/img/lottoexpert.png';
import telaTopo from '../assets/img/topowalk_screenshot.png';
import telaEclipse from '../assets/img/eclipsego_screenshot.png';
import telaPole from '../assets/img/poleposition_real_mockup.png';
import telaLotto from '../assets/img/lottoexpert_app_mockup.png';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const x = home[lang];
---
<!-- Hero Section -->
<header class="relative min-h-screen flex items-center justify-center pt-24 pb-12 overflow-hidden bg-grid-pattern">
    <!-- Overlay escuro centralizado para super contraste sobre o grid -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,#0B1120_100%)] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-base/50 to-brand-base z-0"></div>

    <!-- Abstract gradient blobs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-primary rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-float"
        style="animation-delay: 0s;"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-brand-secondary rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-float"
        style="animation-delay: 2s;"></div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
            <!-- Text Column -->
            <div class="w-full lg:w-1/2 text-center lg:text-left">
                <div
                    class="inline-block mb-4 px-4 py-1.5 rounded-full border border-gray-700/50 bg-gray-800/30 backdrop-blur-sm text-sm text-gray-300 font-medium animate-fade-in-down">
                    <Icon nome="microchip" class="text-brand-primary mr-2" /> <span>{x.hero_badge}</span>
                </div>

                <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-tight mb-6 animate-fade-in-down text-white"
                    style="animation-delay: 0.1s; opacity: 0;" set:html={x.hero_titleHtml}></h1>

                <p class="mt-4 text-lg md:text-xl text-gray-400 max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-10 animate-fade-in-up"
                    style="animation-delay: 0.2s; opacity: 0;">{x.hero_desc}</p>

                <div class="flex flex-col sm:flex-row justify-center lg:justify-start items-center gap-4 animate-fade-in-up"
                    style="animation-delay: 0.3s; opacity: 0;">
                    <a href="#portfolio"
                        class="px-8 py-4 bg-brand-primary hover:bg-brand-primaryHover text-white font-semibold rounded-lg shadow-glow hover:shadow-lg transition-all duration-300 w-full sm:w-auto text-center flex items-center justify-center gap-2">
                        <span>{x.btn_portfolio}</span> <Icon nome="arrow-right" />
                    </a>
                    <a href="#sobre"
                        class="px-8 py-4 bg-transparent border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white font-semibold rounded-lg transition-all duration-300 w-full sm:w-auto text-center">{x.btn_about}</a>
                </div>
            </div>

            <!-- Visual Gallery Column -->
            <div class="w-full lg:w-1/2 flex justify-center items-center relative animate-fade-in-up" style="animation-delay: 0.4s; opacity: 0;">
                <!-- Overlapping 3D interactive showcase -->
                <div class="relative w-full max-w-[480px] h-[340px] md:h-[420px] flex items-center justify-center mt-10 lg:mt-0">

                    <!-- TopoWalk Card (Far Left) -->
                    <a href={rota(lang, 'topowalk.html')} class="absolute w-[150px] md:w-[190px] h-[220px] md:h-[270px] bg-gradient-to-b from-amber-600/10 to-brand-base border border-amber-500/20 rounded-2xl p-3 shadow-2xl glass-panel transform -rotate-12 -translate-x-28 md:-translate-x-32 translate-y-6 hover:-translate-y-12 hover:rotate-[-8deg] hover:scale-105 transition-all duration-500 cursor-pointer group/hero-card block z-10">
                        <div class="flex items-center gap-2 mb-2">
                            <Image src={iconeTopo} alt="Ícone do app TopoWalk" class="w-7 h-7 rounded-lg border border-amber-500/30" width={32} densities={[1, 2]} />
                            <span class="text-[11px] font-bold text-white tracking-tight">TopoWalk</span>
                        </div>
                        <div class="h-24 md:h-32 bg-gray-950/80 rounded-lg flex items-center justify-center border border-gray-800 overflow-hidden relative">
                            <Image src={telaTopo} alt="Tela do app TopoWalk com medição de desnível barométrico em campo" class="w-full h-full object-cover group-hover/hero-card:scale-110 transition-transform duration-500" width={200} densities={[1, 2]} />
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/20 to-transparent flex items-end p-2 justify-center">
                                <span class="text-[9px] text-amber-400 font-bold uppercase tracking-wider">Topografia</span>
                            </div>
                        </div>
                        <p class="text-[9px] md:text-[10px] text-gray-400 mt-2.5 line-clamp-2">{x.hero_topo_desc}</p>
                    </a>

                    <!-- EclipseGo Card (Inner Left) -->
                    <a href={rota(lang, 'eclipsego.html')} class="absolute w-[150px] md:w-[190px] h-[220px] md:h-[270px] bg-gradient-to-b from-yellow-600/10 to-brand-base border border-yellow-500/20 rounded-2xl p-3 shadow-2xl glass-panel transform -rotate-4 -translate-x-10 md:-translate-x-12 -translate-y-4 hover:-translate-y-14 hover:rotate-[-2deg] hover:scale-105 transition-all duration-500 cursor-pointer group/hero-card block z-20">
                        <div class="flex items-center gap-2 mb-2">
                            <Image src={iconeEclipse} alt="Ícone do app EclipseGo" class="w-7 h-7 rounded-lg border border-yellow-500/30" width={32} densities={[1, 2]} />
                            <span class="text-[11px] font-bold text-white tracking-tight">EclipseGo</span>
                        </div>
                        <div class="h-24 md:h-32 bg-gray-950/80 rounded-lg flex items-center justify-center border border-gray-800 overflow-hidden relative">
                            <Image src={telaEclipse} alt="Tela do app EclipseGo" class="w-full h-full object-cover group-hover/hero-card:scale-110 transition-transform duration-500" width={200} densities={[1, 2]} />
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/20 to-transparent flex items-end p-2 justify-center">
                                <span class="text-[9px] text-yellow-400 font-bold uppercase tracking-wider">{x.app_eclipse_tag}</span>
                            </div>
                        </div>
                        <p class="text-[9px] md:text-[10px] text-gray-400 mt-2.5 line-clamp-2">{x.hero_eclipse_desc}</p>
                    </a>

                    <!-- Pole Position Card (Inner Right) -->
                    <a href={rota(lang, 'poleposition.html')} class="absolute w-[160px] md:w-[200px] h-[240px] md:h-[295px] bg-gradient-to-b from-lime-600/10 to-brand-base border-2 border-lime-500/30 rounded-2xl p-3.5 shadow-[0_0_30px_rgba(132,204,22,0.25)] glass-panel transform rotate-4 translate-x-10 md:translate-x-12 -translate-y-6 hover:-translate-y-16 hover:rotate-[2deg] hover:scale-105 transition-all duration-500 cursor-pointer group/hero-card block z-30">
                        <div class="flex items-center gap-2 mb-2">
                            <Image src={iconePole} alt="Ícone do app Pole Position" class="w-8 h-8 rounded-lg border border-lime-500/30" width={32} densities={[1, 2]} />
                            <span class="text-xs font-bold text-white tracking-tight">Pole Position</span>
                        </div>
                        <div class="h-28 md:h-36 bg-gray-950/80 rounded-lg flex items-center justify-center border border-gray-800 overflow-hidden relative">
                            <Image src={telaPole} alt="Painel de telemetria do Pole Position com dados de volta e Força G" class="w-full h-full object-cover group-hover/hero-card:scale-110 transition-transform duration-500" width={200} densities={[1, 2]} />
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/20 to-transparent flex items-end p-2 justify-center">
                                <span class="text-[9px] text-lime-400 font-bold uppercase tracking-wider">Telemetria GPS</span>
                            </div>
                        </div>
                        <p class="text-[9px] md:text-[10px] text-gray-300 mt-2.5 line-clamp-2 font-medium">{x.hero_pole_desc}</p>
                    </a>

                    <!-- LottoExpert Card (Far Right) -->
                    <a href={rota(lang, 'lottoexpert.html')} class="absolute w-[150px] md:w-[190px] h-[220px] md:h-[270px] bg-gradient-to-b from-purple-600/10 to-brand-base border border-purple-500/20 rounded-2xl p-3 shadow-2xl glass-panel transform rotate-12 translate-x-28 md:translate-x-32 translate-y-6 hover:-translate-y-12 hover:rotate-[8deg] hover:scale-105 transition-all duration-500 cursor-pointer group/hero-card block z-10">
                        <div class="flex items-center gap-2 mb-2">
                            <Image src={iconeLotto} alt="Ícone do app LottoExpert" class="w-7 h-7 rounded-lg border border-purple-500/30" width={32} densities={[1, 2]} />
                            <span class="text-[11px] font-bold text-white tracking-tight">LottoExpert</span>
                        </div>
                        <div class="h-24 md:h-32 bg-gray-950/80 rounded-lg flex items-center justify-center border border-gray-800 overflow-hidden relative">
                            <Image src={telaLotto} alt="Tela do app LottoExpert com gerador de fechamentos para Mega-Sena" class="w-full h-full object-cover group-hover/hero-card:scale-110 transition-transform duration-500" width={200} densities={[1, 2]} />
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/20 to-transparent flex items-end p-2 justify-center">
                                <span class="text-[9px] text-purple-400 font-bold uppercase tracking-wider">Loterias</span>
                            </div>
                        </div>
                        <p class="text-[9px] md:text-[10px] text-gray-400 mt-2.5 line-clamp-2">{x.hero_lotto_desc}</p>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Down indicator -->
    <div
        class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce flex flex-col items-center text-gray-500 pointer-events-none">
        <span class="text-xs tracking-widest uppercase mb-2">{x.scroll}</span>
        <Icon nome="chevron-down" />
    </div>
</header>

<!-- Sobre Section -->
<section id="sobre" class="py-24 relative z-10 bg-brand-base">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-brand-surface/50 opacity-50 z-[-1]"></div>
    <div class="container mx-auto px-6 md:px-12">

        <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Image / Graphics Side -->
            <div class="w-full lg:w-1/2">
                <div class="relative w-full aspect-square max-w-md mx-auto">
                    <div
                        class="absolute inset-0 bg-gradient-to-tr from-brand-primary to-brand-secondary rounded-2xl transform rotate-3 opacity-20 blur-xl">
                    </div>
                    <div
                        class="absolute inset-0 border border-gray-700/50 bg-brand-surface rounded-2xl p-8 flex flex-col justify-center relative overflow-hidden glass-panel group hover:border-gray-600 transition-colors duration-500">
                        <!-- Tech decorations -->
                        <Icon nome="server" class="text-5xl text-gray-800 mb-6 group-hover:text-gray-700 transition-colors duration-500" />

                        <h3 class="text-2xl font-bold text-white mb-2">{x.solid_foundation}</h3>
                        <p class="text-brand-primary font-medium mb-4">{x.since_2004}</p>

                        <div class="space-y-3 mb-6">
                            <div
                                class="flex items-center gap-3 text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                                <Icon nome="check" class="text-brand-primary" /> <span>{x.arch_perf}</span>
                            </div>
                            <div
                                class="flex items-center gap-3 text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                                <Icon nome="check" class="text-brand-primary" /> <span>{x.extreme_scale}</span>
                            </div>
                            <div
                                class="flex items-center gap-3 text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                                <Icon nome="check" class="text-brand-primary" /> <span>{x.code_quality}</span>
                            </div>
                            <div
                                class="flex items-center gap-3 text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                                <Icon nome="check" class="text-brand-primary" /> <span>{x.ai_solutions}</span>
                            </div>
                        </div>

                        <!-- Expand Tech Stack -->
                        <div class="pt-4 border-t border-gray-800/80 w-full mt-auto">
                            <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-wider mb-3">{x.stack_title}</p>
                            <div class="flex flex-wrap gap-3 items-center opacity-70 group-hover:opacity-100 transition-opacity duration-300">
                                <!-- AWS e Docker -->
                                <Icon conjunto="brands" nome="aws" class="text-xl hover:text-orange-500 transition-colors cursor-pointer" titulo="AWS" />
                                <Icon conjunto="brands" nome="docker" class="text-xl hover:text-blue-500 transition-colors cursor-pointer" titulo="Docker" />
                                <!-- GCP e Azure -->
                                <Icon conjunto="brands" nome="google" class="text-xl hover:text-brand-secondary transition-colors cursor-pointer" titulo="Google Cloud (GCP)" />
                                <Icon conjunto="brands" nome="microsoft" class="text-xl hover:text-blue-400 transition-colors cursor-pointer" titulo="Azure" />
                                <!-- Java, Python -->
                                <Icon conjunto="brands" nome="java" class="text-2xl hover:text-red-500 transition-colors cursor-pointer" titulo="Java" />
                                <Icon conjunto="brands" nome="python" class="text-xl hover:text-yellow-500 transition-colors cursor-pointer" titulo="Python" />
                                <!-- Web: Angular & React -->
                                <Icon conjunto="brands" nome="angular" class="text-xl hover:text-red-600 transition-colors cursor-pointer" titulo="Angular" />
                                <Icon conjunto="brands" nome="react" class="text-xl hover:text-cyan-400 transition-colors cursor-pointer" titulo="React" />
                                <!-- Kotlin e Flutter -->
                                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded border border-purple-500/50 text-purple-400 hover:bg-purple-500/10 transition-colors cursor-default" title="Kotlin">KOTLIN</span>
                                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded border border-cyan-500/50 text-cyan-400 hover:bg-cyan-500/10 transition-colors cursor-default" title="Flutter">FLUTTER</span>
                                <!-- AIs do Mercado -->
                                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded border border-emerald-500/50 text-emerald-400 hover:bg-emerald-500/10 transition-colors cursor-default" title="OpenAI">OPENAI</span>
                                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded border border-orange-500/50 text-orange-400 hover:bg-orange-500/10 transition-colors cursor-default" title="Claude AI">CLAUDE</span>
                                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded border border-blue-500/50 text-blue-400 hover:bg-blue-500/10 transition-colors cursor-default" title="Google Gemini">GEMINI</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Text Side -->
            <div class="w-full lg:w-1/2">
                <div
                    class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-secondary/10 text-brand-secondary text-sm font-semibold tracking-wide uppercase border border-brand-secondary/20">{x.about_badge}</div>
                <h2 class="text-3xl md:text-5xl font-bold mb-6" set:html={x.about_titleHtml}></h2>

                <div class="space-y-6 text-gray-400 text-lg leading-relaxed">
                    <p set:html={x.about_p1Html}></p>
                    <p>{x.about_p2}</p>
                    <p class="pl-4 border-l-2 border-brand-primary text-gray-300 italic">{x.about_quote}</p>
                </div>

                <div class="mt-8 pt-8 border-t border-gray-800 flex flex-wrap gap-8">
                    <div>
                        <div class="text-3xl font-bold text-white mb-1" set:html={x.stat_years_titleHtml}></div>
                        <div class="text-sm border-gray-500 font-medium">{x.stat_years_desc}</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-white mb-1" set:html={x.stat_focus_titleHtml}></div>
                        <div class="text-sm text-gray-500 font-medium">{x.stat_focus_desc}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Portfolio Section -->
<section id="portfolio" class="py-24 bg-brand-surface relative z-10 border-t border-gray-800/50">
    <div class="container mx-auto px-6 md:px-12">

        <div class="text-center max-w-2xl mx-auto mb-16">
            <div
                class="inline-block mb-3 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold tracking-wide uppercase border border-brand-primary/20">{x.port_badge}</div>
            <h2 class="text-3xl md:text-5xl font-bold mb-6">{x.port_title}</h2>
            <p class="text-gray-400 text-lg">{x.port_desc}</p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 max-w-7xl mx-auto gap-8">

            <!-- Card 1: Pole Position -->
            <div
                class="glass-panel rounded-2xl p-1 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_0_25px_rgba(132,204,22,0.3)] group">
                <div
                    class="bg-brand-base rounded-xl h-full p-6 flex flex-col relative overflow-hidden z-10 group-hover:bg-brand-base/80 transition-colors">

                    <!-- Icon Header & Title -->
                    <div class="flex items-center gap-4 mb-6">
                        <Image src={iconePole} alt="Pole Position Logo" class="w-12 h-12 object-contain rounded-xl shadow-[0_0_15px_rgba(132,204,22,0.2)] border border-lime-500/20" width={48} densities={[1, 2]} />
                        <div>
                            <h3 class="text-2xl font-bold text-white">Pole Position</h3>
                            <span class="text-xs text-lime-400 font-semibold tracking-wide uppercase">Kart &amp; Automobilismo</span>
                        </div>
                    </div>

                    <!-- Visual Screenshot Container -->
                    <div class="w-full h-48 bg-gray-950/60 rounded-xl mb-6 border border-gray-800/80 overflow-hidden relative flex items-center justify-center group-hover:border-lime-500/30 transition-all duration-300">
                        <div class="absolute inset-0 bg-gradient-to-tr from-lime-500/5 to-transparent"></div>
                        <Image src={telaPole} alt="Painel de telemetria do Pole Position com volta atual, Força G e mapa de pista" class="w-[125px] h-[160px] object-cover rounded-md shadow-2xl border border-gray-800/80 transform translate-y-4 group-hover:translate-y-1 group-hover:scale-105 transition-all duration-500" width={160} densities={[1, 2]} />
                    </div>

                    <p class="text-gray-400 mb-8 flex-grow text-sm leading-relaxed">{x.app_pole_desc}</p>

                    <div class="space-y-3 mt-auto pt-6 border-t border-gray-800">
                        <a href={apps.poleposition.play} target="_blank" rel="noopener noreferrer"
                            class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-white font-medium transition-colors">
                            <Icon conjunto="brands" nome="google-play" class="text-brand-primary" /> <span>{x.btn_google_play}</span>
                        </a>
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <a href={rota(lang, 'poleposition.html')}
                                class="flex items-center justify-center py-2 rounded text-[11px] font-semibold tracking-wide text-gray-400 border border-gray-700 hover:border-gray-500 hover:text-white transition-colors bg-gray-800/30">{x.btn_app_page}</a>
                            <a href={rota(lang, 'poleposition-privacy.html')}
                                class="flex items-center justify-center py-2 rounded text-[11px] font-semibold tracking-wide text-gray-400 border border-gray-700 hover:border-gray-500 hover:text-white transition-colors bg-gray-800/30 text-center px-1">{x.btn_privacy}</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: TopoWalk -->
            <div
                class="glass-panel rounded-2xl p-1 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_0_25px_rgba(217,119,6,0.3)] group">
                <div
                    class="bg-brand-base rounded-xl h-full p-6 flex flex-col relative overflow-hidden z-10 group-hover:bg-brand-base/80 transition-colors">

                    <!-- Icon Header & Title -->
                    <div class="flex items-center gap-4 mb-6">
                        <Image src={iconeTopo} alt="TopoWalk Logo" class="w-12 h-12 object-contain rounded-xl shadow-[0_0_15px_rgba(217,119,6,0.2)] border border-amber-500/20" width={48} densities={[1, 2]} />
                        <div>
                            <h3 class="text-2xl font-bold text-white">TopoWalk</h3>
                            <span class="text-xs text-amber-500 font-semibold tracking-wide uppercase">Topografia &amp; SIG</span>
                        </div>
                    </div>

                    <!-- Visual Screenshot Container -->
                    <div class="w-full h-48 bg-gray-950/60 rounded-xl mb-6 border border-gray-800/80 overflow-hidden relative flex items-center justify-center group-hover:border-amber-500/30 transition-all duration-300">
                        <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/5 to-transparent"></div>
                        <Image src={telaTopo} alt="Tela do app TopoWalk mostrando cálculo de altimetria barométrica" class="w-[125px] h-[160px] object-cover rounded-md shadow-2xl border border-gray-800/80 transform translate-y-4 group-hover:translate-y-1 group-hover:scale-105 transition-all duration-500" width={160} densities={[1, 2]} />
                    </div>

                    <p class="text-gray-400 mb-8 flex-grow text-sm leading-relaxed">{x.app_topo_desc}</p>

                    <div class="space-y-3 mt-auto pt-6 border-t border-gray-800">
                        <a href={apps.topowalk.play} target="_blank" rel="noopener noreferrer"
                            class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-white font-medium transition-colors">
                            <Icon conjunto="brands" nome="google-play" class="text-brand-primary" /> <span>{x.btn_google_play}</span>
                        </a>
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <a href={rota(lang, 'topowalk.html')}
                                class="flex items-center justify-center py-2 rounded text-[11px] font-semibold tracking-wide text-gray-400 border border-gray-700 hover:border-gray-500 hover:text-white transition-colors bg-gray-800/30">{x.btn_app_page}</a>
                            <a href={rota(lang, 'topowalk-privacy.html')}
                                class="flex items-center justify-center py-2 rounded text-[11px] font-semibold tracking-wide text-gray-400 border border-gray-700 hover:border-gray-500 hover:text-white transition-colors bg-gray-800/30 text-center px-1">{x.btn_privacy}</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3: LottoExpert -->
            <div
                class="glass-panel rounded-2xl p-1 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_0_25px_rgba(139,92,246,0.3)] group">
                <div
                    class="bg-brand-base rounded-xl h-full p-6 flex flex-col relative overflow-hidden z-10 group-hover:bg-brand-base/80 transition-colors">

                    <!-- Icon Header & Title -->
                    <div class="flex items-center gap-4 mb-6">
