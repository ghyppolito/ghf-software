---
// Landing do EclipseGo em português (/eclipsego.html). Corpo em components/EclipseGo.astro, textos em
// i18n/eclipsego.ts. Links da página para a home vão à home do mesmo idioma. O dourado do EclipseGo
// é claro: a pílula do menu do celular usa texto preto (Nav `realce="primary-texto-preto"`).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EclipseGo from '../components/EclipseGo.astro';
import { eclipsego } from '../i18n/eclipsego';
import { rota } from '../i18n/ui';
import JsonLd from '../components/JsonLd.astro';
import { mobileApplication } from '../i18n/apps';

const lang = 'pt';
const x = eclipsego[lang];
const home = rota(lang, 'index.html');
---
<Base
  title={x.title}
  description={x.description}
  og={{
    titulo: x.og_title,
    descricao: x.og_description,
    imagem: '/assets/eclipse-go.png',
  }}
  lang={lang}
  caminho="eclipsego.html"
  tema="eclipsego"
  favicon="/assets/eclipse-go-favicon.png"
  classeBody="bg-brand-base text-gray-400 antialiased selection:bg-brand-primary selection:text-black font-sans overflow-x-hidden"
>
  <JsonLd slot="jsonld" dados={mobileApplication('eclipsego')} />
  <Nav
    lang={lang}
    caminho="eclipsego.html"
    inicio={home}
    realce="primary-texto-preto"
    itens={[
      { href: `${home}#sobre`, chave: 'nav_about' },
      { href: `${home}#portfolio`, chave: 'nav_portfolio' },
      { href: `${home}#contato`, chave: 'nav_contact', destaque: true },
    ]}
  />
  <EclipseGo lang={lang} />
  {/* A página antiga só tinha o e-mail entre os canais (sem YouTube nem Instagram do app). */}
  <Footer
    lang={lang}
    inicio={home}
    prefixoAncora={home}
    redes={{}}
    appAtual="eclipsego.html"
    fundo="surface"
  />
</Base>
