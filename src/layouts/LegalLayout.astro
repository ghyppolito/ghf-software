---
// Layout das páginas legais (WP-08, fatia 6), sobre o Base. Reproduz o hero, o card e a tipografia
// das páginas legais antigas — sumário e largura de leitura são WP-10. O corpo é o `.md` de
// src/content/legal/ (slot padrão); a tipografia dele vem dos seletores `.legal-corpo …` de
// src/styles/global.css, que repetem as classes que o dicionário JS antigo punha em cada tag.
// Título (h1) e data ficam no hero, uma vez: o plugin de src/markdown/legal.mjs tira os dois do
// corpo, e a data vem do front-matter `lastUpdated`. Nav e footer entram pelos slots `nav` e
// `footer` (cada página legal tem as suas variações, por prop).
import Base from './Base.astro';
import { legal, dataLegal } from '../i18n/legal';
import type { Idioma } from '../i18n/ui';

interface Props {
  lang: Idioma;
  /** caminho pt da página, ex.: 'eclipsego-privacy.html' */
  caminho: string;
  title: string;
  description: string;
  /** h1 do hero */
  titulo: string;
  /** front-matter `lastUpdated` (`AAAA-MM` ou `AAAA-MM-DD`) */
  lastUpdated: string;
  /** bloco de src/styles/global.css */
  tema: string;
  favicon?: string;
  classeBody?: string;
  /** cor do selo "Documento Legal" do hero (classes literais por variante) */
  selo: 'amarelo' | 'primary' | 'lima';
  /** ícone do selo (Font Awesome); termos de uso: `fa-file-contract` */
  iconeSelo?: string;
  /** botão abaixo do card */
  voltar: { href: string; texto: string };
}

const {
  lang,
  caminho,
  title,
  description,
  titulo,
  lastUpdated,
  tema,
  favicon,
  classeBody,
  selo,
  iconeSelo = 'fa-shield-halved',
  voltar,
} = Astro.props;
const x = legal[lang];

const CLASSES_SELO = {
  // eclipsego-privacy.html
  amarelo: 'inline-block mb-4 px-4 py-1.5 rounded-full border border-yellow-500/30 bg-yellow-900/20 text-sm text-yellow-400 font-semibold',
  // topowalk-privacy.html e lottoexpert-*.html (primary do tema: terracota no TopoWalk, violeta no LottoExpert)
  primary: 'inline-block mb-4 px-4 py-1.5 rounded-full border border-brand-primary/30 bg-brand-primary/20 text-sm text-brand-primary font-semibold',
  // poleposition-privacy.html
  lima: 'inline-block mb-4 px-4 py-1.5 rounded-full border border-lime-500/20 bg-lime-900/10 text-sm text-lime-400 font-medium',
};
---
<Base
  title={title}
  description={description}
  lang={lang}
  caminho={caminho}
  tema={tema}
  favicon={favicon}
  classeBody={classeBody}
>
  <slot name="nav" />

  <!-- Hero -->
  <div class="w-full pt-32 pb-12 bg-grid-pattern relative border-b border-gray-800/50">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-base via-transparent to-brand-base z-0"></div>
    <div class="container mx-auto px-6 md:px-12 relative z-10 text-center">
      <div class={CLASSES_SELO[selo]}>
        <i class={`fa-solid ${iconeSelo} mr-2`} aria-hidden="true"></i> {x.selo}
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">{titulo}</h1>
      <p class="text-gray-500 text-lg">{x.rotulo_data} {dataLegal(lang, lastUpdated)}</p>
    </div>
  </div>

  <!-- Texto legal -->
  <main class="py-16 relative z-10 bg-brand-base">
    <div class="container mx-auto px-6 md:px-12">
      <div class="max-w-4xl mx-auto glass-panel p-8 md:p-12 rounded-2xl shadow-xl">
        <div class="legal-corpo leading-relaxed text-gray-400">
          <slot />
        </div>
      </div>

      <div class="max-w-4xl mx-auto mt-8 text-center">
        <a
          href={voltar.href}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-gray-700 text-gray-300 hover:text-white hover:border-brand-primary hover:bg-gray-800/50 transition-all font-semibold"
        >
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <span>{voltar.texto}</span>
        </a>
      </div>
    </div>
  </main>

  <slot name="footer" />
</Base>
