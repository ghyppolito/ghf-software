---
// Layout único (WP-08). <head> de todas as páginas geradas: metadados, og:*, canonical, hreflang,
// a fonte (Inter local, ADR-006 §3) e o CSS compilado do Tailwind (ADR-003). O tema da página vai em `data-tema` no <html>.
// SEO (WP-11, ADR-005): canonical = og:url = a própria URL; um hreflang por língua da página no mapa
// (src/i18n/idiomas.json, ADR-007 §4) e x-default (→ en se a página tem en, senão pt; D8/D18), só
// nas páginas com mais de uma língua; og:image:width/height lidos do cabeçalho do arquivo em public/
// (nunca declarados à mão — D16: as imagens 1200×630 são outro WP); JSON-LD pelo slot `jsonld`.
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import { SITE } from '../i18n/ui';
import { IDIOMAS, hreflang, linguasDe, rota, type Idioma } from '../i18n/idiomas';
import SugestaoIdioma from '../components/SugestaoIdioma.astro';

/** Largura e altura de um PNG ou JPEG, lidas do cabeçalho; undefined se o formato for outro. */
function dimensoes(arquivo: string): { largura: number; altura: number } | undefined {
  const b = readFileSync(arquivo);
  if (b.length >= 24 && b.readUInt32BE(0) === 0x89504e47 && b.toString('latin1', 12, 16) === 'IHDR') {
    return { largura: b.readUInt32BE(16), altura: b.readUInt32BE(20) };
  }
  if (b[0] === 0xff && b[1] === 0xd8) {
    let i = 2;
    while (i + 9 < b.length) {
      if (b[i] !== 0xff) return undefined;
      const marcador = b[i + 1];
      if (marcador === 0xff) { i += 1; continue; }
      // SOF0..SOF15, exceto DHT (C4), JPG (C8) e DAC (CC): altura e largura do quadro
      if (marcador >= 0xc0 && marcador <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marcador)) {
        return { altura: b.readUInt16BE(i + 5), largura: b.readUInt16BE(i + 7) };
      }
      i += 2 + b.readUInt16BE(i + 2);
    }
  }
  return undefined;
}

// Título e descrição do cartão de compartilhamento (og:* e twitter:*) são o `title` e a
// `description` da página, sem texto próprio: uma fonte só por página (WP-21).
interface Og {
  /** caminho absoluto no site, ex.: /assets/GHFSoftware.png */
  imagem?: string;
  tipo?: string;
}

interface Props {
  title: string;
  description: string;
  og?: Og;
  lang: Idioma;
  /** caminho pt da página, ex.: 'index.html', 'lottoexpert.html' */
  caminho: string;
  /** bloco de src/styles/global.css; 'ghf' é o da home */
  tema: string;
  noindex?: boolean;
  classeBody?: string;
  /** favicon da página (as landings de app usam o do app): o caminho do PNG em public/assets/; o
   *  publicado é a cópia de src/assets/img/ reduzida a 48 px */
  favicon?: string;
}

const {
  title,
  description,
  og = {},
  lang,
  caminho,
  tema,
  noindex = false,
  favicon = '/assets/GHFSoftware.png',
  classeBody = 'bg-brand-base text-gray-100 antialiased selection:bg-brand-primary selection:text-white font-sans overflow-x-hidden',
} = Astro.props;

// Línguas da página no mapa; a 404, fora dele, só tem pt e não declara hreflang.
const linguas = linguasDe(caminho);
const outras = linguas.filter((l) => l !== lang);
const temPar = linguas.length > 1;
const url = (l: Idioma) => SITE + rota(l, caminho);
const canonica = url(lang);
const padrao: Idioma = linguas.includes('en') ? 'en' : 'pt';
const caminhoImagem = og.imagem ?? '/assets/GHFSoftware.png';
if (!caminhoImagem.startsWith('/')) {
  throw new Error(`og.imagem deve ser caminho do site, ex.: /assets/x.png (recebido: ${caminhoImagem})`);
}
const imagem = SITE + caminhoImagem;
// Premissa: o build roda na raiz do repositório (npm run build), e a imagem publicada em
// /assets/x.png é o arquivo public/assets/x.png, copiado byte a byte para dist/ (ADR-002 §3).
// O '.' antes do caminho impede que o '/' inicial faça o path.resolve voltar à raiz do disco.
const tamanho = dimensoes(path.resolve(process.cwd(), 'public', '.' + caminhoImagem));

// Favicon (WP-12, ADR-006 §1): PNG de 48 px gerado por getImage() da cópia em src/assets/img/ de
// mesmo nome, não o arquivo de public/ (o lottoexpert_favicon_v3.png tem 296 KB). Favicon sem
// cópia falha o build.
const imagens = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.png', { eager: true });
const origemFavicon = imagens[`../assets/img/${path.posix.basename(favicon)}`];
if (!favicon.startsWith('/assets/') || !origemFavicon) {
  throw new Error(`favicon ${favicon}: sem cópia em src/assets/img/ (ADR-006 §1)`);
}
const iconeAba = await getImage({ src: origemFavicon.default, width: 48, format: 'png' });
---
<!doctype html>
<html lang={hreflang(lang)} class="scroll-smooth" data-tema={tema}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/png" href={iconeAba.src}>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    <link rel="canonical" href={canonica}>
    {temPar && linguas.map((l) => <link rel="alternate" hreflang={hreflang(l)} href={url(l)}>)}
    {temPar && <link rel="alternate" hreflang="x-default" href={url(padrao)}>}

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content={og.tipo ?? 'website'}>
    <meta property="og:site_name" content="GHF Software">
    <meta property="og:url" content={canonica}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={imagem}>
    {tamanho && <meta property="og:image:width" content={String(tamanho.largura)}>}
    {tamanho && <meta property="og:image:height" content={String(tamanho.altura)}>}
    <meta property="og:locale" content={IDIOMAS[lang].ogLocale}>
    {outras.map((l) => <meta property="og:locale:alternate" content={IDIOMAS[l].ogLocale}>)}
    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imagem}>
    <slot name="jsonld" />

    {/* Inter servida pelo site (astro.config.mjs, `fonts`): @font-face, preload do woff2 e o
        fallback com métricas ajustadas. */}
    <Font cssVariable="--fonte-inter" preload />
  </head>
  <body class={classeBody}>
    <slot />
    {/* No fim do <body>: a faixa não é o primeiro ponto de Tab (WP-15, ADR-007 §7). */}
    <SugestaoIdioma lang={lang} caminho={caminho} />
  </body>
</html>
