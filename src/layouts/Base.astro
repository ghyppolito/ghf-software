---
// Layout único (WP-08). <head> de todas as páginas geradas: metadados, og:*, canonical, hreflang,
// a fonte (Inter local, ADR-006 §3) e o CSS compilado do Tailwind (ADR-003). O tema da página vai em `data-tema` no <html>.
// SEO (WP-11, ADR-005): canonical = og:url = a própria URL; hreflang pt-BR, en e x-default (→ en,
// D8/D18) nas páginas com par; og:image:width/height lidos do cabeçalho do arquivo em public/
// (nunca declarados à mão — D16: as imagens 1200×630 são outro WP); JSON-LD pelo slot `jsonld`.
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE, rota, type Idioma } from '../i18n/ui';

/** Largura e altura de um PNG ou JPEG, lidas do cabeçalho; undefined se o formato for outro. */
function dimensoes(arquivo: string): { largura: number; altura: number } | undefined {
  const b = readFileSync(arquivo);
  if (b.length >= 24 && b.readUInt32BE(0) === 0x89504e47 && b.toString('latin1', 12, 16) === 'IHDR') {
    return { largura: b.readUInt32BE(16), altura: b.readUInt32BE(20) };
  }
  if (b[0] === 0xff && b[1] === 0xd8) {
    let i = 2;
    while (i + 9 < b.length) {
      if (b[i] !== 0xff) return undefined;
      const marcador = b[i + 1];
      if (marcador === 0xff) { i += 1; continue; }
      // SOF0..SOF15, exceto DHT (C4), JPG (C8) e DAC (CC): altura e largura do quadro
      if (marcador >= 0xc0 && marcador <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marcador)) {
        return { altura: b.readUInt16BE(i + 5), largura: b.readUInt16BE(i + 7) };
      }
      i += 2 + b.readUInt16BE(i + 2);
    }
  }
  return undefined;
}

// Título e descrição do cartão de compartilhamento (og:* e twitter:*) são o `title` e a
// `description` da página, sem texto próprio: uma fonte só por página (WP-21).
interface Og {
  /** caminho absoluto no site, ex.: /assets/GHFSoftware.png */
  imagem?: string;
  tipo?: string;
}

interface Props {
  title: string;
  description: string;
  og?: Og;
  lang: Idioma;
  /** caminho pt da página, ex.: 'index.html', 'lottoexpert.html' */
  caminho: string;
  /** bloco de src/styles/global.css; 'ghf' é o da home */
  tema: string;
  /** a página tem par no outro idioma (hreflang recíproco) */
  temPar?: boolean;
  noindex?: boolean;
  classeBody?: string;
  /** favicon da página (as landings de app usam o do app) */
  favicon?: string;
}

const {
  title,
  description,
  og = {},
  lang,
  caminho,
  tema,
  temPar = true,
  noindex = false,
  favicon = '/assets/GHFSoftware.png',
  classeBody = 'bg-brand-base text-gray-100 antialiased selection:bg-brand-primary selection:text-white font-sans overflow-x-hidden',
} = Astro.props;

const url = (l: Idioma) => SITE + rota(l, caminho);
const canonica = temPar ? url(lang) : `${SITE}/${caminho}`;
const caminhoImagem = og.imagem ?? '/assets/GHFSoftware.png';
if (!caminhoImagem.startsWith('/')) {
  throw new Error(`og.imagem deve ser caminho do site, ex.: /assets/x.png (recebido: ${caminhoImagem})`);
}
const imagem = SITE + caminhoImagem;
// Premissa: o build roda na raiz do repositório (npm run build), e a imagem publicada em
// /assets/x.png é o arquivo public/assets/x.png, copiado byte a byte para dist/ (ADR-002 §3).
// O '.' antes do caminho impede que o '/' inicial faça o path.resolve voltar à raiz do disco.
const tamanho = dimensoes(path.resolve(process.cwd(), 'public', '.' + caminhoImagem));
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'} class="scroll-smooth" data-tema={tema}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon}>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    <link rel="canonical" href={canonica}>
    {temPar && <link rel="alternate" hreflang="pt-BR" href={url('pt')}>}
    {temPar && <link rel="alternate" hreflang="en" href={url('en')}>}
    {temPar && <link rel="alternate" hreflang="x-default" href={url('en')}>}

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content={og.tipo ?? 'website'}>
    <meta property="og:site_name" content="GHF Software">
    <meta property="og:url" content={canonica}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={imagem}>
    {tamanho && <meta property="og:image:width" content={String(tamanho.largura)}>}
    {tamanho && <meta property="og:image:height" content={String(tamanho.altura)}>}
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'}>
    {temPar && <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'}>}
    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imagem}>
    <slot name="jsonld" />

    {/* Inter servida pelo site (astro.config.mjs, `fonts`): @font-face, preload do woff2 e o
        fallback com métricas ajustadas. */}
    <Font cssVariable="--fonte-inter" preload />
    <!-- Font Awesome: sai no WP-12 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  <body class={classeBody}>
    <slot />
  </body>
</html>
